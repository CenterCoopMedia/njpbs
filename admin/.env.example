# Optional comma-separated additional Vite dev hosts; empty allows only Vite defaults.
ADMIN_DEV_ALLOWED_HOSTS=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Required for development builds; independently pin the expected development app ID.
# An absent or mismatched pin refuses the development target.
VITE_FIREBASE_EXPECTED_DEV_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FUNCTIONS_BASE_URL=https://api.example.org
# Set true for local emulator work outside npm run dev.
VITE_USE_EMULATORS=false

# Public author release assertion; keep false until the live routes are verified.
VITE_AUTHOR_PAGES_LIVE=false

# Private studio pilot; disabled unless explicitly enabled for this build.
VITE_LIVE_PRODUCTION_ENABLED=false

# Optional sender for account verification and password-reset guidance.
# Unset or placeholder values show generic inbox guidance without an address.
VITE_VERIFICATION_EMAIL_SENDER=REPLACE_ME@example.org

# Repository identity for milestone URL validation in this build.
VITE_CANONICAL_GITHUB_REPOSITORY=

# Enable the video replacement What's new note only after runtime cleanup is active.
VITE_VIDEO_REPLACEMENT_ENABLED=false

# Deployment environment name. `development` marks a development build and hides
# the self-service account options and password reset.
VITE_CMS_DEPLOYMENT_ENVIRONMENT=

# Public site origin for Home source reads. Required for development builds;
# empty uses the production site origin for production builds.
VITE_PUBLIC_SITE_ORIGIN=

# Home layout editing stays on unless this is false.
VITE_CMS_HOME_LAYOUTS_ENABLED=

# Set true to offer content preview to editors in this build.
VITE_CMS_PREVIEW_ENABLED=

# Installed reader bridge: set true and supply its JSON manifest after both
# deployed readers are proven. Empty leaves the bridge off.
VITE_CMS_READER_BRIDGE_ENABLED=
VITE_CMS_READER_BRIDGE_MANIFEST=

# Validated studio preset JSON. Empty disables studio setup only.
VITE_CMS_STUDIO_CONFIGURATION=
