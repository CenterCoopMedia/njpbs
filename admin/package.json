{
  "name": "njpbs-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:shard:1": "vitest run --shard=1/2",
    "test:shard:2": "vitest run --shard=2/2",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:boot": "playwright test --config playwright.boot.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@popperjs/core": "^2.11.8",
    "@tiptap/extension-heading": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "firebase": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "github-slugger": "^2.0.0",
    "jsdom": "^27.2.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
}
