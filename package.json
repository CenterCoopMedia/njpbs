{
  "name": "njpbs-firebase-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Root workspace for the NJ PBS Firebase emulators and the admin, cms-api, Worker, publisher and preview-renderer checks.",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "workspaces": [
    "functions",
    "admin",
    "cms-api"
  ],
  "scripts": {
    "dev": "vite admin --config admin/vite.config.ts",
    "admin:dev": "npm run dev -w njpbs-admin",
    "admin:build": "npm run build -w njpbs-admin",
    "admin:test": "npm run test -w njpbs-admin --",
    "admin:test:related": "npm run test:related -w njpbs-admin --",
    "admin:test:shard:1": "npm run test:shard:1 -w njpbs-admin --",
    "admin:test:shard:2": "npm run test:shard:2 -w njpbs-admin --",
    "admin:test:visual": "npm run test:visual -w njpbs-admin",
    "admin:test:visual:update": "npm run test:visual:update -w njpbs-admin",
    "admin:deploy": "bash scripts/deploy-admin.sh",
    "preadmin:e2e:local": "node scripts/prepare-emulator-env.mjs",
    "admin:e2e:local": "node scripts/admin-e2e-local.mjs",
    "admin:perf:baseline": "node scripts/admin-perf-baseline.mjs",
    "cms-api:check": "npm run check -w njpbs-cms-api",
    "cms-api:test": "npm run test -w njpbs-cms-api",
    "cms-api:deploy": "npm run deploy -w njpbs-cms-api",
    "test:public-worker": "vitest run --config workers/vitest.public-worker.config.mts && vitest run tests/public-background-runtime.test.ts --maxWorkers=1 --no-file-parallelism",
    "check:preview-worker": "tsc --project workers/tsconfig.preview-worker.json",
    "test:preview-worker": "vitest run --config workers/vitest.preview-worker.config.mts",
    "test:preview-renderer": "vitest run --config preview-renderer/vitest.config.mts",
    "test:cloud-publisher": "vitest run --config publisher/vitest.config.mts && node scripts/test-no-build-cloud-runtime.mjs",
    "cms:browser": "bash scripts/cms-debug-browser.sh",
    "cms:diagnose": "node scripts/cms-diagnostics.mjs",
    "cms:inventory:article-posts:read-only": "node scripts/inventory-article-posts-read-only.mjs",
    "cms:migrate:article-to-post": "node scripts/convert-retired-article-to-post.mjs",
    "cms:migrate:media-categories": "node scripts/seed-media-categories.mjs",
    "media:perf:seed": "node scripts/seed-media-perf-fixtures.mjs",
    "cms:migrate:media-category-assignments": "node scripts/backfill-media-category-assignments.mjs",
    "cms:import:s3-source": "node scripts/import-s3-source-media.mjs",
    "emulators:start": "node scripts/run-firebase-emulators.mjs start",
    "test:rules": "node scripts/run-firebase-emulators.mjs exec firestore \"vitest run tests/rules\"",
    "pretest:preflight": "node scripts/prepare-emulator-env.mjs",
    "test:preflight": "vitest run tests/preflight",
    "pretest:functions": "npm run test:preflight",
    "test:functions": "node scripts/run-firebase-emulators.mjs exec auth,firestore,functions \"node scripts/run-functions-tests.mjs\"",
    "test:loader": "node scripts/run-firebase-emulators.mjs exec firestore \"npm --prefix site run test:cms-loader\"",
    "test": "npm run test:rules && npm run test:functions",
    "check:staff-sites": "tsc --project workers/tsconfig.staff-sites.json",
    "test:staff-sites": "vitest run tests/staff-site-worker.test.ts tests/dev-staff-origin.test.ts tests/dev-preview-staff-origin.test.ts tests/functions/site-access-unit.test.js tests/shadow-staff-gateway.test.ts tests/transitional-post-read-worker.test.ts tests/live-blog-feed.test.ts tests/record-background-routing.test.ts tests/post-withdrawal-retirement-prep.test.ts tests/durable-post-withdrawals.test.ts",
    "test:published-post-reader": "vitest run tests/published-post-reader-relay.test.ts --maxWorkers=1 --no-file-parallelism && node scripts/test-published-post-reader-runtime.mjs",
    "cms:fastpub:dev-proof": "node -e \"console.error('Use python3 scripts/fastpub-dev-proof.py directly with inherited fd 3 and, for --publish, fd 4.'); process.exitCode = 1;\" --"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@playwright/mcp": "0.0.82",
    "esbuild": "^0.28.1",
    "firebase": "^11",
    "firebase-admin": "14.2.0",
    "firebase-tools": "15.31.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "jose": "^6.2.8",
    "wrangler": "4.134.0"
  },
  "overrides": {
    "glob": "14.0.2",
    "qs": "6.16.1",
    "uuid@<11.1.1": "11.1.1",
    "miniflare@5.20260811.1-alpha": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "miniflare@5.20260917.0-alpha": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  }
}
