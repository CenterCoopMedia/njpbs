          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Prefer to mail a check?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Make checks payable to NJ PBS and mail to: "
                },
                {
                  "type": "text",
                  "text": "NJ PBS, 1 Normal Ave., Montclair, NJ 07043",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Online donation processing is handled through PBS, and this site does not collect payment information. A mailed check supports NJ PBS but does not activate PBS Passport; to start or renew Passport streaming, donate through the new donation portal."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            }
          ]
        }
      }
