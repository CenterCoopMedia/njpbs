      "section": "transition-notice",
      "data": {
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Giving and Passport during the transition"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Existing gifts, including one-time and recurring gifts, ended June 30, 2026. If you would like to continue supporting NJ PBS, you will need to set up a new monthly recurring gift or make a one-time donation through the new donation portal. "
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PBS manages Passport account status. Use the PBS Passport lookup tool to check an existing account. If access does not appear or a renewal is due, contact NJ PBS for help with the current account or donation path."
                }
              ]
            }
          ]
        }
      }
    },
    {
