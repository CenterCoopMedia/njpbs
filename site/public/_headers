# Security-header baseline and report-only CSP for njpbs.org.
#
# Source of truth: docs/security-headers-policy.md. Refs #253.
#
# Astro copies this file into the build output for static asset responses.
# Worker responses must apply the same security-header contract.
# Report-only CSP records violations without blocking requests. Configure
# collection and review observed script hosts before enabling enforcement.
#
# Meaning search uses a same-origin module worker and WASM runtime. Only public
# pinned model files connect to Hugging Face and its observed weight redirect.
# Queries and passage text are encoded locally. Third-party scripts stay limited
# to the named PBS, Cloudflare, Google, Mailchimp and Wisepops hosts below.
#
/_publication.json
  Access-Control-Allow-Origin: https://admin.njpbs.org

/_content-status.json
  Access-Control-Allow-Origin: https://admin.njpbs.org

/_home-sources.json
  Access-Control-Allow-Origin: https://admin.njpbs.org

/_schedule-sources.json
  Access-Control-Allow-Origin: https://admin.njpbs.org
  Cache-Control: no-store

# A Post URL can change from missing to published, or back, in one generation.
# Apply this to the requested path, including the shared 404.html fallback.
/posts/*
  Cache-Control: no-store

# Protected previews must not be cached or indexed.
/resources/nj-politics/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Bare max-age on purpose. Do not add includeSubDomains or preload until every
  # *.njpbs.org host (watch.njpbs.org is PBS-run) is confirmed HTTPS-only, or it
  # forces HTTPS on all of them, not just the apex. See the HSTS row in
  # docs/security-headers-policy.md.
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self "https://player.pbs.org"), encrypted-media=(self "https://player.pbs.org" "https://www.youtube-nocookie.com" "https://www.youtube.com" "https://player.vimeo.com" "https://www.facebook.com"), camera=(), microphone=(), payment=(), usb=()
