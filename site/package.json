{
  "name": "newnjpbs-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/build-with-production-sync.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"src/**/*.astro\"",
    "test": "NODE_PATH=./node_modules vitest run",
    "test:cms-loader": "vitest run --no-file-parallelism --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "test:preview-content": "vitest run --config vitest.preview-content.config.ts",
    "build:renderer": "tsx scripts/build-compiled-renderer.ts",
    "verify:renderer": "npm run build:renderer && tsx scripts/check-compiled-renderer.ts && tsx scripts/check-public-resource-admission.ts private",
    "test:home-v2-parity": "npm run build:renderer && tsx scripts/build-public-post-renderer.ts --test-pages && tsx scripts/check-home-v2-parity.ts --render-only",
    "probe:media-manager": "node scripts/probe-launch-content.mjs",
    "sync:launch-content": "node scripts/sync-launch-content.mjs",
    "sync:spotlight-news": "node scripts/sync-spotlight-news.mjs",
    "prepare:related-stories": "tsx scripts/prepare-related-stories.ts",
    "sync:schedule": "tsx scripts/sync-schedule.mjs",
    "guardrails": "vitest run --config vitest.guardrails.config.ts",
    "guardrails:source": "node ../.github/scripts/metered-api-scan.mjs",
    "guardrails:docs": "vitest run --config vitest.guardrails.config.ts scripts/docs-pointer-guardrail-source.test.ts scripts/onboarding-source-privacy-guardrail-source.test.ts",
    "assert:public-contract": "node scripts/assert-public-contract.mjs",
    "prepare:public-worker-artifact": "tsx scripts/prepare-public-worker-artifact.ts",
    "upload:public-worker-candidate": "tsx scripts/upload-public-worker-candidate.ts",
    "activate:public-worker-candidate": "bash ../scripts/activate-public-worker-candidate.sh",
    "check:cloud-release-access": "tsx scripts/check-cloud-release-access.ts",
    "activate:public-media-lifecycle": "bash ../scripts/activate-public-media-lifecycle.sh",
    "cancel-unclaimed:cms-publication-baseline": "bash ../scripts/cancel-unclaimed-cms-publication-baseline.sh",
    "cancel-claimed:cms-publication-baseline": "bash ../scripts/cancel-claimed-cms-publication-baseline.sh",
    "cancel-claimed:cms-publication-content": "bash ../scripts/cancel-claimed-cms-publication-content.sh",
    "settle-unpublished-withdrawal:cms-content": "bash ../scripts/settle-unpublished-cms-content-withdrawal.sh",
    "retire:cms-publication-baseline": "bash ../scripts/retire-cms-publication-baseline.sh",
    "measure:cms-loader": "tsx scripts/measure-cms-loader.ts",
    "index:search": "pagefind --site dist",
    "build:workers": "npm run guardrails:source && npm run build:public-post-renderer -- --compile-only && npm run sync:launch-content && npm run sync:spotlight-news && npm run build && npm run build:public-post-renderer -- --copy-assets && npm run assert:public-contract && npm run guardrails",
    "verify:deploy": "npm run guardrails:source && npm run build && npm run assert:public-contract && npm run guardrails",
    "verify:public": "npm run guardrails:source && PUBLIC_ONLY=1 astro build && PUBLIC_ONLY=1 npm run guardrails",
    "build:public-post-renderer": "tsx scripts/build-public-post-renderer.ts",
    "test:public-post-runtime": "tsx scripts/check-public-resource-admission.ts && npm --prefix ../tests/public-post-runtime test && npm run test:public-page-runtime",
    "test:public-page-runtime": "tsx scripts/build-public-post-renderer.ts --test-pages && tsx scripts/check-public-resource-admission.ts development && tsx scripts/check-public-page-renderer.ts && tsx scripts/check-public-page-serving.ts && npm run test:public-record-runtime",
    "test:public-record-runtime": "tsx scripts/check-public-record-renderer.ts && tsx scripts/check-published-record-images.ts",
    "build:shadow": "tsx scripts/build-shadow-post-renderer.ts",
    "test:shadow": "tsx scripts/build-shadow-post-renderer.ts --fixtures && vitest run --config vitest.shadow-posts.config.ts",
    "compare:shadow": "tsx scripts/compare-shadow-posts.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3",
    "@babylonjs/core": "^7",
    "@huggingface/transformers": "4.3.0",
    "astro": "^7.4.4",
    "mermaid": "11.17.2",
    "pdfkit": "^0.20.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2",
    "sitemap": "9.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@aws-sdk/client-s3": "3.1116.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/parser": "^8.62.1",
    "astro-eslint-parser": "^1.4.0",
    "axe-core": "4.12.1",
    "css-tree": "3.2.1",
    "es-module-lexer": "2.3.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "firebase-admin": "^14.2.0",
    "happy-dom": "^21.0.4",
    "markdownlint": "0.41.1",
    "pagefind": "1.5.0",
    "parse5": "7.3.0",
    "playwright": "^1.61.1",
    "remark-parse": "11.0.0",
    "remark-validate-links": "13.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vitest": "^4.1.12",
    "yaml": "2.9.0"
  }
}
