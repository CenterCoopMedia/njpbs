# Cloud operations require the account ID from the deployment environment.
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME_CLOUDFLARE_ACCOUNT_ID
# Independent expected account for development publication; both values must match.
CMS_DEV_CLOUDFLARE_ACCOUNT_ID=REPLACE_ME_DEV_CLOUDFLARE_ACCOUNT_ID
# Required when PUBLIC_SHARE_PAGE=1. Use an exact HTTPS origin; the template is rejected.
PUBLIC_SHARE_UPLOAD_ORIGIN=https://uploads.example.org
# Worker binding: JSON destination groups, with placeholder addresses only.
FANOUT_DESTINATIONS_JSON={"default":["REPLACE_ME@example.org"],"info":["REPLACE_ME@example.org","REPLACE_ME_INFO@example.org"],"engineering":["REPLACE_ME_ENGINEERING@example.org"],"programming":["REPLACE_ME_PROGRAMMING@example.org"],"desk":["REPLACE_ME_DESK@example.org"]}
# Substitute these into worker/wrangler.toml when preparing deployment config.
RATE_LIMIT_KV_NAMESPACE_ID=REPLACE_ME_KV_NAMESPACE_ID
# Exact HTTPS intake URL with the /api/report path, no port, query or credentials.
# The renderer refuses example domains, so replace this placeholder.
REPORT_INTAKE_URL=https://intake.example.org/api/report

# Required public deployment resource pins; no literal resource defaults.
CLOUDFLARE_PUBLIC_ZONE_ID=REPLACE_ME_CLOUDFLARE_PUBLIC_ZONE_ID
CLOUDFLARE_PUBLIC_WORKER_TAG=REPLACE_ME_CLOUDFLARE_PUBLIC_WORKER_TAG
