---
import PublicSiteLayout from "../layouts/PublicSiteLayout.astro";
import tokenSource from "../styles/design-tokens.css?raw";
import {
  DESIGN_ASSETS,
  DESIGN_FONT_ASSETS,
  DESIGN_SYSTEM_VERSION,
  groupDesignAssets,
  groupDesignTokens,
  parseDesignTokens,
} from "../lib/design-system-catalog";
import { measureDesignContrast } from "../lib/design-system-contrast";
import {
  DESIGN_PLAYGROUND_TOKEN_SPECS,
  getDesignPlaygroundTokens,
  groupDesignPlaygroundTokens,
} from "../lib/design-system-playground";

const tokenGroups = groupDesignTokens(parseDesignTokens(tokenSource));
const tokenCount = tokenGroups.reduce((count, group) => count + group.tokens.length, 0);
const assetGroups = groupDesignAssets(DESIGN_ASSETS);
const imageAssetCount = DESIGN_ASSETS.length;
const assetCount = DESIGN_ASSETS.length + DESIGN_FONT_ASSETS.length;
const contrastPairings = measureDesignContrast(tokenSource);
const playgroundGroups = groupDesignPlaygroundTokens(
  getDesignPlaygroundTokens(tokenSource),
);

---

<PublicSiteLayout
  title="NJ PBS Design and Asset Lab"
  description="The internal catalog for NJ PBS web design tokens and approved site assets."
  preview={false}
  noindex={true}
  searchable={false}
>
  <div class="design-lab" data-design-version={DESIGN_SYSTEM_VERSION} data-pagefind-ignore>
    <header class="design-lab__intro">
      <div class="wrap design-lab__intro-inner">
        <p class="design-lab__eyebrow">Internal design reference</p>
        <h1>NJ PBS Design and Asset Lab</h1>
        <p class="design-lab__lead">
          Inspect production values, try reversible draft changes against real
          components, and download approved web assets from one governed workspace.
        </p>
        <dl class="release-facts">
          <div><dt>Lab release</dt><dd>v{DESIGN_SYSTEM_VERSION}</dd></div>
          <div><dt>Tokens cataloged</dt><dd>{tokenCount}</dd></div>
          <div><dt>Assets cataloged</dt><dd>{assetCount}</dd></div>
        </dl>
        <div class="download-actions" aria-label="Token downloads">
          <a class="lab-button" href="/design-system/tokens.css" download>Download CSS</a>
          <a class="lab-button lab-button--secondary" href="/design-system/tokens.json" download>
            Download JSON
          </a>
        </div>
      </div>
    </header>

    <nav class="design-lab__nav" aria-label="Design lab sections">
      <div class="wrap design-lab__nav-inner">
        <a href="#playground" data-lab-nav>Playground</a>
        <a href="#components" data-lab-nav>Components</a>
        <a href="#governance" data-lab-nav>Status guide</a>
        <a href="#tokens" data-lab-nav>Tokens <span>{tokenCount}</span></a>
        <a href="#contrast" data-lab-nav>Contrast</a>
        <a href="#assets" data-lab-nav>Assets <span>{assetCount}</span></a>
        <a href="#next" data-lab-nav>Releases</a>
      </div>
    </nav>

    <div class="wrap design-lab__main">
      <section id="playground" class="lab-section lab-section--playground" aria-labelledby="playground-heading">
        <header class="section-heading">
          <p class="section-kicker">Experimental draft — browser local</p>
          <h2 id="playground-heading">Try token changes without changing the site</h2>
          <p>
            Edit the selected foundations below. Valid changes apply only to the draft
            specimen in this tab; they never write to the CMS or production CSS. Download
            a draft when it is ready for discussion and review.
          </p>
        </header>

        <div class="playground-toolbar">
          <p>
            <strong data-playground-count>0</strong> of {DESIGN_PLAYGROUND_TOKEN_SPECS.length}
            allowlisted tokens changed
          </p>
          <div class="playground-actions" aria-label="Draft actions">
            <button class="playground-button playground-button--secondary" type="button" data-playground-compare aria-pressed="false">
              Compare baseline
            </button>
            <button class="playground-button playground-button--secondary" type="button" data-playground-reset disabled>
              Reset draft
            </button>
            <button class="playground-button" type="button" data-playground-export-css disabled>
              Download draft CSS
            </button>
            <button class="playground-button" type="button" data-playground-export-json disabled>
              Download draft JSON
            </button>
          </div>
        </div>
        <p class="playground-status" aria-live="polite" data-playground-status>
          No draft changes. The live baseline is unchanged.
        </p>
        <p class="playground-note">
          Format validation keeps the preview safe; it does not certify contrast or brand approval.
          Treat every download as an experimental proposal until the normal review gates pass.
        </p>

        <div class="playground-workspace">
          <form class="playground-controls" data-playground-form novalidate>
            {playgroundGroups.map((group) => (
              <fieldset>
                <legend>{group.group}</legend>
                {group.tokens.map((token) => {
                  const controlId = `playground-${token.name.slice(2)}`;
                  const errorId = `${controlId}-error`;
                  return (
                    <div class="playground-control" data-playground-control>
                      <label for={controlId}>
                        <span class="playground-control__label">
                          {token.constraint.kind === "color" && (
                            <span
                              class="playground-control__swatch"
                              style={`--playground-color: ${token.baseline}`}
                              data-playground-swatch
                              aria-hidden="true"
                            ></span>
                          )}
                          <strong>{token.label}</strong>
                        </span>
                        <code>{token.name}</code>
                      </label>
                      <input
                        id={controlId}
                        name={token.name}
                        value={token.baseline}
                        data-playground-input
                        data-playground-name={token.name}
                        data-playground-baseline={token.baseline}
                        data-playground-kind={token.constraint.kind}
                        aria-describedby={errorId}
                        aria-invalid="false"
                        autocomplete="off"
                        spellcheck="false"
                      />
                      <span id={errorId} class="playground-control__error" data-playground-error></span>
                    </div>
                  );
                })}
              </fieldset>
            ))}
          </form>

          <div class="playground-preview" data-playground-preview-grid data-compare="off">
            <section class="playground-frame" data-playground-baseline-frame hidden>
              <header><h3>Live baseline</h3><span>Production values</span></header>
              <iframe
                src="/design-system/specimens/public/"
                title="Public component specimen with the live token baseline"
                data-playground-baseline
              ></iframe>
            </section>
            <section class="playground-frame">
              <header><h3>Draft preview</h3><span>Experimental values</span></header>
              <iframe
                src="/design-system/specimens/public/"
                title="Public component specimen with experimental token overrides"
                data-playground-draft
              ></iframe>
            </section>
          </div>
        </div>
      </section>

      <section id="components" class="lab-section" aria-labelledby="components-heading">
        <header class="section-heading">
          <p class="section-kicker">Live public components</p>
          <h2 id="components-heading">Inspect the real interface at useful widths</h2>
          <p>
            The frame renders production Astro components with clearly labeled fixture
            content. Change its width to exercise the components' own responsive rules.
          </p>
        </header>
        <div class="specimen-toolbar">
          <div class="specimen-widths" role="group" aria-label="Specimen viewport width">
            <button type="button" data-specimen-width="wide" aria-pressed="true">
              Wide <span>1280</span>
            </button>
            <button type="button" data-specimen-width="tablet" aria-pressed="false">
              Tablet <span>768</span>
            </button>
            <button type="button" data-specimen-width="phone" aria-pressed="false">
              Phone <span>390</span>
            </button>
          </div>
          <a href="/design-system/specimens/public/">Open the full specimen page</a>
        </div>
        <p class="specimen-status" aria-live="polite" data-specimen-status>
          Showing the wide 1280 pixel frame.
        </p>
        <div class="specimen-stage" data-specimen-stage="wide">
          <iframe
            src="/design-system/specimens/public/"
            title="Responsive public-site component specimens"
          ></iframe>
        </div>
      </section>

      <section id="governance" class="lab-section" aria-labelledby="governance-heading">
        <header class="section-heading">
          <p class="section-kicker">Foundation</p>
          <h2 id="governance-heading">Know what is ready to use</h2>
          <p>
            Brand files and web implementation values are related, but they are not
            interchangeable. Draft work will always carry a visible experimental label.
          </p>
        </header>
        <dl class="status-grid">
          <div><dt>Official brand asset</dt><dd>Approved source material for the stated use.</dd></div>
          <div><dt>Production web token</dt><dd>A value currently consumed by the public site or CMS.</dd></div>
          <div><dt>Experimental draft</dt><dd>A playground proposal that is not approved for publication.</dd></div>
          <div><dt>Deprecated</dt><dd>Retained for compatibility, with a replacement identified.</dd></div>
        </dl>
      </section>

      <section id="tokens" class="lab-section" aria-labelledby="tokens-heading">
        <header class="section-heading">
          <p class="section-kicker">Production web tokens</p>
          <h2 id="tokens-heading">The current CSS contract</h2>
          <p>
            Values are read from <code>site/src/styles/design-tokens.css</code> during the
            build. This page does not maintain a second copy.
          </p>
        </header>

        <div class="catalog-filter">
          <label for="token-catalog-filter">
            <strong>Find a token</strong>
            <span>Filter by token name, value, or category.</span>
          </label>
          <div class="catalog-filter__control">
            <input
              id="token-catalog-filter"
              type="search"
              placeholder="Try --color-link or focus"
              autocomplete="off"
              aria-controls="token-catalog"
              aria-describedby="token-catalog-count"
              data-catalog-filter="tokens"
            />
            <output
              id="token-catalog-count"
              for="token-catalog-filter"
              aria-live="polite"
              data-catalog-count="tokens"
            >Showing all {tokenCount} tokens.</output>
          </div>
        </div>
        <p class="catalog-empty" data-catalog-empty="tokens" hidden>
          No tokens match this search. Try a token name, CSS value, or category.
        </p>

        <div id="token-catalog" class="token-groups">
          {tokenGroups.map((group) => (
            <section class="token-group" aria-labelledby={`token-${group.category.toLowerCase().replaceAll(" ", "-")}`} data-catalog-group="tokens">
              <h3 id={`token-${group.category.toLowerCase().replaceAll(" ", "-")}`}>
                {group.category} <span>{group.tokens.length}</span>
              </h3>
              <ul class="token-list">
                {group.tokens.map((token) => (
                  <li
                    class="token-row"
                    data-catalog-item="tokens"
                    data-catalog-search={`${group.category} ${token.name} ${token.value}`}
                  >
                    {token.preview === "paint" ? (
                      <span
                        class="token-swatch"
                        style={`--design-token-swatch: var(${token.name})`}
                        aria-hidden="true"
                      ></span>
                    ) : (
                      <span class="token-marker" aria-hidden="true">Aa</span>
                    )}
                    <div class="token-name">
                      <code>{token.name}</code>
                      <span data-resolved-token={token.name}>{token.value}</span>
                    </div>
                    <code class="token-value">{token.value}</code>
                    <button
                      class="copy-token"
                      type="button"
                      data-copy-token={token.name}
                      aria-label={`Copy ${token.name}`}
                    >
                      Copy name
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="copy-status" aria-live="polite" data-copy-status></p>
      </section>

      <section id="contrast" class="lab-section" aria-labelledby="contrast-heading">
        <header class="section-heading">
          <p class="section-kicker">Accessibility contract</p>
          <h2 id="contrast-heading">Representative contrast pairings</h2>
          <p>
            Ratios are calculated at build time from the same live CSS source. Text
            pairs must clear 4.5:1; focus and other interface indicators must clear 3:1.
            The repository's full contrast suite remains the release gate.
          </p>
        </header>
        <ul class="contrast-grid">
          {contrastPairings.map((pairing) => (
            <li
              class="contrast-card"
              style={`--contrast-foreground: var(${pairing.foreground}); --contrast-background: var(${pairing.background})`}
            >
              <div class="contrast-sample">
                <span>{pairing.kind === "text" ? "Readable type" : "Visible focus"}</span>
              </div>
              <div class="contrast-card__details">
                <h3>{pairing.label}</h3>
                <p>
                  <strong>{pairing.ratio.toFixed(2)}:1</strong>
                  <span>{pairing.passes ? "Pass" : "Fail"} · minimum {pairing.minimum}:1</span>
                </p>
                <code>{pairing.foreground}</code>
                <code>{pairing.background}</code>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="assets" class="lab-section" aria-labelledby="assets-heading">
        <header class="section-heading">
          <p class="section-kicker">Current asset registry</p>
          <h2 id="assets-heading">Approved and production brand files</h2>
          <p>
            Use the stated background and purpose. A production label identifies a
            checked-in web implementation file; it does not make that file a substitute
            for authoritative PBS brand guidance.
          </p>
        </header>
        <div class="catalog-filter">
          <label for="asset-catalog-filter">
            <strong>Find an image asset</strong>
            <span>Filter by name, use, format, status, background, or group.</span>
          </label>
          <div class="catalog-filter__control">
            <input
              id="asset-catalog-filter"
              type="search"
              placeholder="Try passport, SVG, or dark background"
              autocomplete="off"
              aria-controls="asset-catalog"
              aria-describedby="asset-catalog-count"
              data-catalog-filter="assets"
            />
            <output
              id="asset-catalog-count"
              for="asset-catalog-filter"
              aria-live="polite"
              data-catalog-count="assets"
            >Showing all {imageAssetCount} image assets.</output>
          </div>
        </div>
        <p class="catalog-empty" data-catalog-empty="assets" hidden>
          No image assets match this search. Try a name, purpose, format, or status.
        </p>

        <div id="asset-catalog" class="asset-groups">
          {assetGroups.map((group) => (
            <section class="asset-group" aria-labelledby={`asset-${group.group.toLowerCase().replaceAll(" ", "-")}`} data-catalog-group="assets">
              <h3 id={`asset-${group.group.toLowerCase().replaceAll(" ", "-")}`}>
                {group.group} <span>{group.assets.length}</span>
              </h3>
              <div class="asset-grid">
                {group.assets.map((asset) => (
                  <article
                    class="asset-card"
                    data-catalog-item="assets"
                    data-catalog-search={`${group.group} ${asset.name} ${asset.use} ${asset.avoid} ${asset.format} ${asset.status} ${asset.background} background ${asset.path} ${asset.version}`}
                  >
                    <div class:list={["asset-preview", `asset-preview--${asset.background}`]}>
                      <img
                        src={asset.path}
                        alt={asset.alt}
                        width={asset.width}
                        height={asset.height}
                        loading="lazy"
                      />
                    </div>
                    <div class="asset-card__body">
                      <p class:list={["asset-status", `asset-status--${asset.status}`]}>{asset.status}</p>
                      <h4>{asset.name}</h4>
                      <p><strong>Use:</strong> {asset.use}</p>
                      <p><strong>Avoid:</strong> {asset.avoid}</p>
                      <dl>
                        <div><dt>Format</dt><dd>{asset.format}</dd></div>
                        <div><dt>Dimensions</dt><dd>{asset.width} × {asset.height}</dd></div>
                        <div><dt>Version</dt><dd>{asset.version}</dd></div>
                        <div><dt>Background</dt><dd>{asset.background}</dd></div>
                      </dl>
                      <code class="asset-path">{asset.path}</code>
                      <a class="asset-download" href={asset.path} download>
                        Download {asset.name} ({asset.format})
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>

        <section class="font-assets" aria-labelledby="font-assets-heading">
          <header>
            <h3 id="font-assets-heading">Packaged type assets</h3>
            <p>
              The public site packages these PBS Sans files. Reuse its existing family
              declarations so fallback behavior and weights stay consistent.
            </p>
          </header>
          <ul>
            {DESIGN_FONT_ASSETS.map((font) => (
              <li style={`--font-asset-weight: ${font.weight}`}>
                <div>
                  <strong>{font.name}</strong>
                  <span>{font.weight} · {font.format} · {font.status}</span>
                </div>
                <p>The quick brown fox jumps over New Jersey.</p>
                <a href={font.path} download>Download {font.name}</a>
              </li>
            ))}
          </ul>
        </section>
      </section>

      <section id="next" class="lab-section lab-section--next" aria-labelledby="next-heading">
        <header class="section-heading">
          <p class="section-kicker">Releases</p>
          <h2 id="next-heading">Release history</h2>
        </header>
        <ol class="release-roadmap">
          <li><strong>v0.3.1 · Catalog navigation refinement.</strong> Searchable token and image-asset inventories, live result counts, and a persistent section guide for long-page orientation.</li>
          <li><strong>v0.3.0 · Browser-local token playground.</strong> Allowlisted draft overrides, live specimen preview, baseline comparison, reset, and deterministic CSS/JSON export.</li>
          <li><strong>v0.2.0 · Public specimens and complete site-asset catalog.</strong> Real components, responsive frames, usage guidance, hosted fonts, and representative contrast results.</li>
          <li><strong>v0.1.0 · Foundation.</strong> Live token inventory, governance labels, initial brand registry, and CSS/JSON exports.</li>
        </ol>
      </section>
    </div>
  </div>
</PublicSiteLayout>

<script>
  import { setupDesignCatalogFilter } from "../lib/design-system-catalog-filter";
  import {
    serializeDesignTokenCss,
    serializeDesignTokenJson,
    validateDesignTokenOverride,
  } from "../lib/design-system-playground";

  const playgroundForm = document.querySelector<HTMLFormElement>("[data-playground-form]");
  const playgroundInputs = [
    ...document.querySelectorAll<HTMLInputElement>("[data-playground-input]"),
  ];
  const playgroundDraftFrame = document.querySelector<HTMLIFrameElement>("[data-playground-draft]");
  const playgroundBaselineFrame = document.querySelector<HTMLElement>("[data-playground-baseline-frame]");
  const playgroundPreviewGrid = document.querySelector<HTMLElement>("[data-playground-preview-grid]");
  const playgroundCompare = document.querySelector<HTMLButtonElement>("[data-playground-compare]");
  const playgroundReset = document.querySelector<HTMLButtonElement>("[data-playground-reset]");
  const playgroundExportCss = document.querySelector<HTMLButtonElement>("[data-playground-export-css]");
  const playgroundExportJson = document.querySelector<HTMLButtonElement>("[data-playground-export-json]");
  const playgroundCount = document.querySelector<HTMLElement>("[data-playground-count]");
  const playgroundStatus = document.querySelector<HTMLElement>("[data-playground-status]");
  const playgroundVersion =
    document.querySelector<HTMLElement>("[data-design-version]")?.dataset.designVersion ??
    "draft";
  const playgroundDraft = new Map<string, string>();

  const applyPlaygroundDraft = () => {
    const root = playgroundDraftFrame?.contentDocument?.documentElement;
    if (!root) return;
    playgroundInputs.forEach((input) => {
      const name = input.dataset.playgroundName;
      if (name) root.style.removeProperty(name);
    });
    playgroundDraft.forEach((value, name) => root.style.setProperty(name, value));
  };

  const readPlaygroundDraft = () => {
    playgroundDraft.clear();
    let invalidCount = 0;
    let changedCount = 0;

    playgroundInputs.forEach((input) => {
      const name = input.dataset.playgroundName;
      const baseline = input.dataset.playgroundBaseline;
      const control = input.closest<HTMLElement>("[data-playground-control]");
      const error = control?.querySelector<HTMLElement>("[data-playground-error]");
      if (!name || baseline === undefined) return;

      const validation = validateDesignTokenOverride(name, input.value);
      input.setAttribute("aria-invalid", String(!validation.valid));
      if (error) error.textContent = validation.valid ? "" : validation.error;
      if (!validation.valid) {
        invalidCount += 1;
        return;
      }

      if (input.dataset.playgroundKind === "color") {
        const swatch = control?.querySelector<HTMLElement>("[data-playground-swatch]");
        swatch?.style.setProperty("--playground-color", validation.value);
      }
      if (validation.value !== baseline) {
        playgroundDraft.set(name, validation.value);
        changedCount += 1;
      }
    });

    const hasEditedInput = playgroundInputs.some(
      (input) => input.value.trim() !== input.dataset.playgroundBaseline,
    );
    const canExport = changedCount > 0 && invalidCount === 0;
    if (playgroundCount) playgroundCount.textContent = String(changedCount);
    if (playgroundReset) playgroundReset.disabled = !hasEditedInput;
    if (playgroundExportCss) playgroundExportCss.disabled = !canExport;
    if (playgroundExportJson) playgroundExportJson.disabled = !canExport;
    if (playgroundStatus) {
      playgroundStatus.textContent = invalidCount > 0
        ? `${invalidCount} ${invalidCount === 1 ? "value needs" : "values need"} attention before export.`
        : changedCount > 0
          ? `${changedCount} experimental ${changedCount === 1 ? "change is" : "changes are"} active in the draft preview.`
          : "No draft changes. The live baseline is unchanged.";
    }
    applyPlaygroundDraft();
  };

  const downloadPlaygroundDraft = (body: string, extension: "css" | "json") => {
    const blob = new Blob([body], {
      type: extension === "css" ? "text/css;charset=utf-8" : "application/json;charset=utf-8",
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `njpbs-design-token-draft-v${playgroundVersion}.${extension}`;
    link.click();
    window.setTimeout(() => URL.revokeObjectURL(url), 0);
    if (playgroundStatus) playgroundStatus.textContent = `Downloaded the experimental ${extension.toUpperCase()} draft.`;
  };

  playgroundInputs.forEach((input) => input.addEventListener("input", readPlaygroundDraft));
  playgroundDraftFrame?.addEventListener("load", applyPlaygroundDraft);

  playgroundCompare?.addEventListener("click", () => {
    const showBaseline = playgroundCompare.getAttribute("aria-pressed") !== "true";
    playgroundCompare.setAttribute("aria-pressed", String(showBaseline));
    playgroundCompare.textContent = showBaseline ? "Hide baseline" : "Compare baseline";
    if (playgroundBaselineFrame) playgroundBaselineFrame.hidden = !showBaseline;
    if (playgroundPreviewGrid) playgroundPreviewGrid.dataset.compare = showBaseline ? "on" : "off";
  });

  playgroundReset?.addEventListener("click", () => {
    playgroundForm?.reset();
    readPlaygroundDraft();
    playgroundInputs[0]?.focus();
  });

  playgroundExportCss?.addEventListener("click", () => {
    downloadPlaygroundDraft(
      serializeDesignTokenCss(Object.fromEntries(playgroundDraft)),
      "css",
    );
  });

  playgroundExportJson?.addEventListener("click", () => {
    downloadPlaygroundDraft(
      serializeDesignTokenJson(Object.fromEntries(playgroundDraft)),
      "json",
    );
  });

  const specimenStage = document.querySelector<HTMLElement>("[data-specimen-stage]");
  const specimenStatus = document.querySelector<HTMLElement>("[data-specimen-status]");
  const specimenLabels: Record<string, string> = {
    wide: "wide 1280 pixel",
    tablet: "tablet 768 pixel",
    phone: "phone 390 pixel",
  };

  document.querySelectorAll<HTMLButtonElement>("[data-specimen-width]").forEach((button) => {
    button.addEventListener("click", () => {
      const width = button.dataset.specimenWidth;
      if (!width || !specimenStage) return;
      specimenStage.dataset.specimenStage = width;
      document.querySelectorAll<HTMLButtonElement>("[data-specimen-width]").forEach((choice) => {
        choice.setAttribute("aria-pressed", String(choice === button));
      });
      if (specimenStatus) {
        specimenStatus.textContent = `Showing the ${specimenLabels[width]} frame.`;
      }
    });
  });

  const rootStyles = getComputedStyle(document.documentElement);
  document.querySelectorAll<HTMLElement>("[data-resolved-token]").forEach((node) => {
    const token = node.dataset.resolvedToken;
    if (!token) return;
    const value = rootStyles.getPropertyValue(token).trim();
    if (value) node.textContent = `Resolved: ${value}`;
  });

  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  document.querySelectorAll<HTMLButtonElement>("[data-copy-token]").forEach((button) => {
    button.addEventListener("click", async () => {
      const token = button.dataset.copyToken;
      if (!token) return;
      try {
        await navigator.clipboard.writeText(token);
        if (status) status.textContent = `${token} copied.`;
      } catch {
        if (status) status.textContent = `Copy unavailable. Select ${token} from the catalog.`;
      }
    });
  });

  setupDesignCatalogFilter("tokens");
  setupDesignCatalogFilter("assets");

  const labNavigation = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-lab-nav]"),
  ].flatMap((link) => {
    const id = link.hash.slice(1);
    const section = id ? document.getElementById(id) : null;
    return section ? [{ link, section }] : [];
  });
  let navigationFrame = 0;

  const updateLabNavigation = () => {
    navigationFrame = 0;
    const firstEntry = labNavigation[0];
    if (!firstEntry) return;
    const boundary = Math.min(window.innerHeight * 0.32, 260);
    let active = firstEntry;

    labNavigation.forEach((entry) => {
      if (entry.section.getBoundingClientRect().top <= boundary) active = entry;
    });
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
      active = labNavigation[labNavigation.length - 1] ?? active;
    }

    labNavigation.forEach((entry) => {
      if (entry === active) entry.link.setAttribute("aria-current", "location");
      else entry.link.removeAttribute("aria-current");
    });
  };

  const queueNavigationUpdate = () => {
    if (navigationFrame !== 0) return;
    navigationFrame = window.requestAnimationFrame(updateLabNavigation);
  };

  window.addEventListener("scroll", queueNavigationUpdate, { passive: true });
  window.addEventListener("resize", queueNavigationUpdate);
  updateLabNavigation();
</script>

