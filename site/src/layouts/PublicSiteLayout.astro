    .foot-report {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      min-width: var(--target-comfortable);
      padding: 0.05rem 0.45rem;
      border: 0;
      background: none;
      color: var(--text-dim);
      font: inherit;
      text-decoration: none;
      cursor: pointer;
