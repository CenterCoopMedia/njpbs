    /* Collapse with a small cross-browser fit margin below 1280px, moving the
       nav behind a hamburger disclosure. Brand + menu button + Donate stay. */
    @media (width < 80em) {
      .nav-toggle { display: inline-flex; }
      .utility .util-icon,
      .utility .newsletter { display: none; }

      /* Reclaim vertical space on phones. Tighten the header padding and shrink
         the wordmark a touch. */
      .head-inner { padding: 0.55rem 1.25rem; gap: 1rem; }
      /* Shrink the wordmark for the tighter bar; the brand link keeps its 44px
         tap target (the 44px toggle/Donate already set the row height). */
      .brand img { height: 34px; }

      .primary {
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        display: none;
        /* Fully opaque: this panel sits over page content, so readability can't
           depend on backdrop-filter compositing (which not every engine honors). */
        background: var(--color-surface-page);
        border-bottom: 1px solid var(--line);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
      }
      .primary[data-open] {
        display: block;
        /* The full menu (8 sections + Search + Sign in) is taller than a phone in
           landscape; cap it to the space below the header and let it scroll so the
           lower items stay reachable instead of running off-screen. vh fallback
           first for engines without svh; the svh value overrides where supported. */
        max-height: calc(100vh - 3.75rem);
        max-height: calc(100svh - 3.75rem);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
