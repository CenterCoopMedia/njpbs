       the same menu button and panel as the narrow layout. */
    .site-head[data-nav-collapsed] .nav-toggle { display: inline-flex; }
    .site-head[data-nav-collapsed] .utility .util-icon,
    .site-head[data-nav-collapsed] .utility .newsletter { display: none; }
    .site-head[data-nav-collapsed] .primary {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      display: none;
      background: var(--color-surface-page);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    }
    .site-head[data-nav-collapsed] .primary[data-open] {
      display: block;
      max-height: calc(100vh - 4.5rem);
      max-height: calc(100svh - 4.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .site-head[data-nav-collapsed] .primary ul {
      flex-direction: column;
      gap: 0;
      max-width: 84rem;
      margin: 0 auto;
      padding: 0.5rem 1.5rem 1rem;
    }
    .site-head[data-nav-collapsed] .primary li { width: 100%; }
    .site-head[data-nav-collapsed] .primary a { white-space: normal; overflow-wrap: anywhere; }
    .site-head[data-nav-collapsed] .primary a:not(.newsletter) {
      width: 100%;
      min-height: 48px;
      padding: 0.65rem 0;
      font-size: 1rem;
      border-bottom: 1px solid var(--line);
    }
    .site-head[data-nav-collapsed] .primary .newsletter { width: 100%; min-height: 48px; font-size: 1rem; }
    .site-head[data-nav-collapsed] .primary a.active { border-bottom-color: var(--pbs-blue-bright); }
    .site-head[data-nav-collapsed] .primary__util { display: block; }

    /* Without scripts the menu button cannot open, so a desktop header whose
       links do not fit wraps them instead of overflowing the page. */
    @media (scripting: none) and (width >= 80em) {
      .primary { min-width: 0; }
      .primary ul { flex-wrap: wrap; }
    }

    @media (max-width: 360px) {
      .head-inner { padding-inline: 0.75rem; gap: 0.5rem; }
      .brand img { height: 32px; }
      .donate { padding-inline: 0.75rem; }
    }
