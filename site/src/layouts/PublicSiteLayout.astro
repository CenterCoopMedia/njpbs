    .motion-toggle:hover,
    .motion-toggle:focus-visible { color: var(--color-text-on-surface); }
    .motion-toggle__switch {
      position: relative;
      flex: none;
      width: 38px;
      height: 22px;
      border: 1px solid currentColor;
      border-radius: 999px;
      background: var(--line);
    }
    .motion-toggle__switch::after {
      content: "";
      position: absolute;
      inset: 2px auto auto 2px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--color-text-on-surface);
    }
    .motion-toggle[aria-pressed="true"] { color: var(--color-text-on-surface); }
    .motion-toggle[aria-pressed="true"] .motion-toggle__switch {
      background: var(--pbs-blue-bright);
