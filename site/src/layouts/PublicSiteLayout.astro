    }
    .util-icon:hover { color: var(--text); }

    /* Opaque light surfaces keep these actions clear over the frosted header. */
    .newsletter,
    .donate {
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: var(--target-comfortable);
      padding: 0.625rem 1rem;
      border: 1px solid var(--color-control-edge-on-glass);
      border-radius: 12px;
      background: var(--color-text-on-surface);
      color: var(--color-theme-navy);
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
      text-decoration: none;
