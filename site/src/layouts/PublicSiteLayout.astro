    }
    .foot-cols h2 { font-size: 0.95rem; color: var(--color-text-on-surface); margin: 0 0 0.55rem; }
    .foot-cols ul { list-style: none; margin: 0; padding: 0; font-size: 0.88rem; }
    .foot-cols li { margin: 0; }
    .foot-cols li a {
