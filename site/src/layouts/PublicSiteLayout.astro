      flex: none;
      width: 1rem;
      height: auto;
      color: var(--color-action);
    }
    .newsletter:hover,
    .donate:hover {
      background: var(--color-text-soft);
      color: var(--pbs-blue);
    }

    main { display: block; }

    /* Footer */
    .site-foot {
      background: var(--bg-0);
      color: var(--text-dim);
      padding: 2.4rem 1.5rem 4rem;
      padding-bottom: max(4rem, calc(env(safe-area-inset-bottom) + 2.5rem));
      border-top: 1px solid var(--line);
    }
    .site-foot a { color: var(--text-dim); text-decoration: none; }
    .site-foot a:hover,
    .site-foot a:focus-visible {
      color: var(--color-text-on-surface);
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
    .foot-cols {
