    a:focus-visible { outline: var(--focus-outline); outline-offset: var(--focus-offset); }

    /* Keep the inline navigation intact through narrower desktop widths. Font-relative
       breakpoints also move the disclosure wider when a reader enlarges text. */
    @media (80em <= width <= 86.1875em) {
