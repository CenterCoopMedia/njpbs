---
import {
  homepageNewsTopicHref,
  type HomepageNewsTopic,
} from "../lib/homepage-news-topics";

interface Props {
  topics: readonly HomepageNewsTopic[];
}

const { topics } = Astro.props as Props;
---

<nav class="news-topics" aria-label="News topics" data-homepage-news-topics>
  <div class="news-topics__inner">
    <span class="news-topics__label">News</span>
    <ul class="news-topics__list">
      {
        topics.map((topic) => (
          <li>
            <a href={homepageNewsTopicHref(topic)}>{topic.label}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <style>
    .news-topics {
      border-bottom: 1px solid var(--color-border);
      background: var(--color-surface-panel);
      color: var(--color-text-on-surface);
    }

    .news-topics__inner {
      display: flex;
      max-width: var(--wrap);
      margin: 0 auto;
      padding-block: var(--space-2);
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-color: var(--color-border-strong) transparent;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }

    .news-topics__label {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      min-height: var(--target-comfortable);
      padding-right: var(--space-4);
      border-right: 1px solid var(--color-border-strong);
      color: var(--color-link);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .news-topics__list {
      display: flex;
      flex: 0 0 auto;
      gap: var(--space-1);
      margin: 0;
      padding: 0 0 0 var(--space-2);
      list-style: none;
    }

    .news-topics__list li {
      display: flex;
      flex: 0 0 auto;
    }

    .news-topics__list a {
      display: inline-flex;
      align-items: center;
      min-height: var(--target-comfortable);
      padding: 0 var(--space-3);
      border-bottom: 3px solid transparent;
      color: var(--color-text-muted);
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.2;
      text-decoration: none;
      white-space: nowrap;
      transition:
        color var(--motion-duration-fast) var(--motion-ease-standard),
        background-color var(--motion-duration-fast) var(--motion-ease-standard),
        border-color var(--motion-duration-fast) var(--motion-ease-standard);
    }

    .news-topics__list a:hover {
      border-bottom-color: var(--color-brand-bright);
      background: var(--color-surface-elevated);
      color: var(--color-text-on-surface);
    }

    .news-topics__list a:focus-visible {
      position: relative;
      z-index: 1;
      border-radius: var(--radius-control);
      outline: var(--focus-outline);
      outline-offset: var(--focus-offset);
    }

    @media (max-width: 640px) {
      .news-topics__label {
        padding-right: var(--space-3);
      }

      .news-topics__list a {
        padding-inline: var(--space-2);
      }
    }

    @media print {
      .news-topics {
        display: none;
      }
    }
  </style>
</nav>
