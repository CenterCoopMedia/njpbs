---
interface Props {
  caption?: string;
  credit?: string;
}

const caption = Astro.props.caption?.trim() ? Astro.props.caption : "";
const credit = Astro.props.credit?.trim();
---

{(caption || credit) && <figcaption class="post-image-caption">{caption}{credit && <span class="post-image-credit">{credit}</span>}</figcaption>}

<style>
  .post-image-credit { display: block; }
  .post-image-caption {
    margin: 0;
    padding: 0.75rem 0;
    color: inherit;
    font-size: 0.9375rem;
    line-height: 1.5;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
</style>
