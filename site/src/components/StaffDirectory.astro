---
import AuthorSocialLinks from "./AuthorSocialLinks.astro";
import CmsHeroBackground from "./CmsHeroBackground.astro";
import { staffProfileHref, type StaffDirectoryEntry } from "../lib/staff-directory";

interface Props {
  staff: readonly StaffDirectoryEntry[];
  title: string;
  description: string;
  heroBackgroundImage?: {
    url: string;
    width: number;
    height: number;
  } | null;
  heroBackgroundPosition?: "center" | "top" | "bottom";
}

const {
  staff,
  title,
  description,
  heroBackgroundImage,
  heroBackgroundPosition,
} = Astro.props as Props;
---

<section class="staff-directory">
  <header
    class:list={[
      "staff-directory__hero",
      { "cms-hero-surface": Boolean(heroBackgroundImage) },
    ]}
  >
    <CmsHeroBackground
      image={heroBackgroundImage}
      position={heroBackgroundPosition}
    />
    <div class="staff-directory__hero-inner">
      <div class="staff-directory__intro">
        <p class="staff-directory__kicker">People of NJ PBS</p>
        <h1>{title}</h1>
        <p class="staff-directory__lead">{description}</p>
      </div>
    </div>
  </header>

  <div class="staff-directory__body">
    {staff.length === 0 ? (
      <section class="staff-directory__empty" aria-labelledby="staff-empty-title">
        <p class="staff-directory__empty-kicker">Staff directory</p>
        <h2 id="staff-empty-title">No staff profiles are available yet.</h2>
      </section>
    ) : (
      <>
        <div class="staff-directory__section-head">
          <p>{staff.length} {staff.length === 1 ? "profile" : "profiles"}</p>
          <span aria-hidden="true"></span>
        </div>
        <ul class="staff-grid">
          {staff.map((person) => (
            <li>
              <article class="staff-card">
                <a class="staff-card__profile" href={staffProfileHref(person)}>
                  <span class="staff-card__portrait">
                    {person.photo ? (
                      <img
                        src={person.photo.displayUrl}
                        width={person.photo.width}
                        height={person.photo.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        style={`object-position: ${person.photo.focalX}% ${person.photo.focalY}%`}
                      />
                    ) : (
                      <span class="staff-card__initials" aria-hidden="true">
                        {person.initials}
                      </span>
                    )}
                    <span class="staff-card__portrait-wash" aria-hidden="true"></span>
                  </span>
                  <span class="staff-card__identity">
                    <span class="staff-card__name" role="heading" aria-level="2">
                      {person.displayName}
                    </span>
                    {person.jobTitle && (
                      <span class="staff-card__title">{person.jobTitle}</span>
                    )}
                    <span class="staff-card__action">
                      {person.profilePageReady === false ? "Profile publishing" : <>View profile <span aria-hidden="true">→</span></>}
                    </span>
                  </span>
                </a>

                {person.photo?.credit && (
                  <p class="staff-card__credit">Photo: {person.photo.credit}</p>
                )}
                {person.bio && <p class="staff-card__bio">{person.bio}</p>}
                <AuthorSocialLinks
                  displayName={person.displayName}
                  links={person.links}
                />
              </article>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>

<style>
  .staff-directory {
    min-height: 70vh;
  }

  .staff-directory__hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(
        70% 140% at 82% -15%,
        rgba(77, 94, 232, 0.42),
        transparent 62%
      ),
      radial-gradient(
        70% 110% at 8% 118%,
        rgba(0, 172, 0, 0.14),
        transparent 67%
      ),
      linear-gradient(145deg, var(--bg-1), var(--bg-0));
  }

  .staff-directory__hero::after {
    position: absolute;
    inset: auto -8rem -12rem auto;
    z-index: -1;
    width: clamp(18rem, 42vw, 38rem);
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 50%;
    content: "";
    opacity: 0.72;
  }

  .staff-directory__hero-inner {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 7.5rem) var(--gutter)
      clamp(3rem, 6vw, 5rem);
  }

  .staff-directory__kicker,
  .staff-directory__empty-kicker {
    margin: 0;
    color: var(--color-link);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .staff-directory h1 {
    margin: 0.45rem 0 0;
    color: var(--text);
    font-size: clamp(3.25rem, 10vw, 7.25rem);
    font-weight: 900;
    letter-spacing: var(--heading-tracking);
    line-height: 0.9;
  }

  .staff-directory__lead {
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    color: var(--text-dim);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.62;
  }

  .staff-directory__body {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) var(--gutter)
      clamp(4rem, 8vw, 7rem);
  }

  .staff-directory__section-head {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .staff-directory__section-head p {
    margin: 0;
    color: var(--text-quiet);
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .staff-directory__section-head span {
    flex: 1;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        var(--pbs-blue-bright),
        rgba(0, 172, 0, 0.55),
        transparent
      );
  }

  .staff-grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, 18rem), 1fr)
    );
    gap: clamp(1rem, 2.5vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .staff-grid > li {
    min-width: 0;
  }

  .staff-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-accent);
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.055), transparent 42%),
      var(--color-surface-panel);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 18px 44px rgba(0, 0, 0, 0.2);
    transition:
      border-color var(--motion-duration-standard) var(--motion-ease-standard),
      transform var(--motion-duration-standard) var(--motion-ease-standard),
      box-shadow var(--motion-duration-standard) var(--motion-ease-standard);
  }

  .staff-card:hover {
    border-color: var(--line-strong);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 24px 54px rgba(0, 0, 0, 0.32);
    transform: translateY(-3px);
  }

  .staff-card__profile {
    position: relative;
    display: grid;
    color: inherit;
    text-decoration: none;
  }

  .staff-card__profile:focus-visible {
    outline: none;
  }

  .staff-card__profile:focus-visible::after {
    position: absolute;
    z-index: 1;
    inset: var(--focus-offset);
    border: var(--focus-outline);
    border-radius: var(--radius-accent);
    pointer-events: none;
    content: "";
  }

  .staff-card__portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    background:
      radial-gradient(
        90% 90% at 70% 15%,
        rgba(77, 94, 232, 0.52),
        transparent 60%
      ),
      radial-gradient(
        90% 90% at 10% 100%,
        rgba(0, 172, 0, 0.18),
        transparent 68%
      ),
      var(--color-surface-elevated);
  }

  .staff-card__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-duration-emphasis)
      var(--motion-ease-standard);
  }

  .staff-card:hover .staff-card__portrait img {
    transform: scale(1.025);
  }

  .staff-card__portrait-wash {
    position: absolute;
    inset: auto 0 0;
    height: 28%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(6, 7, 15, 0.38));
  }

  .staff-card__initials {
    color: var(--text);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.06em;
  }

  .staff-card__identity {
    display: grid;
    gap: 0.4rem;
    padding: 1.15rem 1.2rem 0.95rem;
  }

  .staff-card__name {
    color: var(--text);
    font-size: 1.32rem;
    font-weight: 850;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .staff-card__title {
    color: var(--text-dim);
    font-size: 0.93rem;
    line-height: 1.42;
  }

  .staff-card__action {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    margin-top: 0.35rem;
    color: var(--color-link);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .staff-card__credit {
    margin: 0;
    padding: 0 1.2rem;
    color: var(--text-quiet);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .staff-card__bio {
    margin: 0;
    padding: 1rem 1.2rem 0;
    color: var(--text-dim);
    font-size: 0.94rem;
    line-height: 1.62;
    white-space: pre-line;
  }

  .staff-card :global(.author-social) {
    margin: auto 0 0;
    padding: 1.15rem 1.2rem 1.25rem;
  }

  .staff-directory__empty {
    max-width: 45rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-accent);
    background:
      linear-gradient(145deg, rgba(77, 94, 232, 0.12), transparent 58%),
      var(--color-surface-panel);
  }

  .staff-directory__empty h2 {
    margin: 0.5rem 0 0;
    color: var(--text);
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    line-height: 1.1;
  }

  .staff-directory__empty p:last-child {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: var(--text-dim);
    line-height: 1.65;
  }

  @media (max-width: 420px) {
    .staff-directory__hero-inner,
    .staff-directory__body {
      padding-right: 1rem;
      padding-left: 1rem;
    }
  }
</style>
