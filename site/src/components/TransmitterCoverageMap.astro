---
import {
  coverageMapViewBox,
  coveragePlaceLabels,
  coverageSites,
  coverageStateShapes,
  type CoverageCategory,
} from "../data/transmitter-coverage";
import { officialNjCountyShapes } from "../data/official-nj-boundaries";

const categoryLabels: Record<CoverageCategory, string> = {
  "nj-full": "NJ PBS full power",
  "nj-low": "On-air NJ PBS low-power",
  "nj-coming": "Proposed NJ PBS low-power",
  "neighbor-whyy": "Full-power public television",
  "neighbor-wnet": "Full-power public television",
  "neighbor-lehigh": "Full-power public television",
};

const filters = [
  { id: "all", label: "Show all" },
  { id: "nj", label: "NJ PBS only" },
  { id: "nj-full", label: "Main NJ PBS stations" },
  { id: "nj-low", label: "On-air NJ PBS low-power stations" },
  { id: "nj-coming", label: "Proposed NJ PBS low-power stations" },
  { id: "neighbors", label: "Nearby public TV" },
] as const;

const drawOrder = [...coverageSites].sort((a, b) => {
  const rank = (category: CoverageCategory) => category.startsWith("neighbor") ? 0 : category === "nj-coming" ? 1 : 2;
  return rank(a.category) - rank(b.category);
});

const initialSite = coverageSites[0];
const clientSites = coverageSites.map((site) => ({
  id: site.id,
  category: site.category,
  network: site.network,
  callsigns: site.callsigns,
  communities: site.communities,
  facilityIds: site.facilityIds,
  channel: site.channel,
  x: site.x,
  y: site.y,
  radiusMinMiles: site.radiusMinMiles,
  radiusMaxMiles: site.radiusMaxMiles,
}));
const tableRows = coverageSites.flatMap((site) =>
  site.callsigns.map((callsign, index) => ({
    callsign,
    community: site.communities[index],
    facilityId: site.facilityIds[index],
    service: site.category === "nj-coming"
      ? "Proposed NJ PBS low-power"
      : site.category === "nj-low"
        ? "On-air NJ PBS low-power"
        : `${site.network} · Full power`,
    channel: "channels" in site ? site.channels[index] : site.channel,
    radius: `${site.radiusMinMiles}–${site.radiusMaxMiles} miles`,
  })),
);

const fccFacilityUrl = (facilityId: number) =>
  `https://enterpriseefiling.fcc.gov/dataentry/public/tv/publicFacilityDetails.html?facilityId=${facilityId}`;

// The top county fills hide the underlay's internal strokes, leaving one shoreline edge.
---

<section
  class="coverage"
  data-coverage-map
  data-sites={JSON.stringify(clientSites)}
  data-category-labels={JSON.stringify(categoryLabels)}
  aria-labelledby="coverage-map-heading"
>
  <div class="coverage__guide" aria-labelledby="coverage-guide-heading">
    <h2 id="coverage-guide-heading">How to use this map</h2>
    <ol>
      <li><span>1</span>Choose which signals to show.</li>
      <li><span>2</span>Select a station name, or choose a colored area on the map.</li>
      <li><span>3</span>Read the station details.</li>
    </ol>
  </div>

  <div class="coverage__toolbar" aria-label="Coverage map controls">
    <div class="coverage__filters" role="group" aria-label="Show coverage areas">
      {filters.map((filter, index) => (
        <button
          type="button"
          class="coverage-filter"
          data-coverage-filter={filter.id}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {filter.label}
        </button>
      ))}
    </div>
    <div class="coverage__zoom" role="group" aria-label="Map view controls">
      <button type="button" data-map-zoom="out" aria-label="Zoom out">−</button>
      <button type="button" data-map-zoom="reset">Reset</button>
      <button type="button" data-map-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" class="coverage__fullscreen" data-map-fullscreen aria-pressed="false">Full screen</button>
      <span class="sr-only" data-map-zoom-status aria-live="polite">Map zoom 100%</span>
    </div>
  </div>

  <div class="coverage__grid">
    <figure class="coverage__figure">
      <svg
        class="coverage__map"
        data-coverage-svg
        viewBox={`0 0 ${coverageMapViewBox.width} ${coverageMapViewBox.height}`}
        role="group"
        aria-labelledby="coverage-map-heading coverage-map-description"
      >
        <title id="coverage-map-heading">NJ PBS broadcast coverage and neighboring overlap</title>
        <desc id="coverage-map-description">
          Current FCC service contours for NJ PBS and neighboring public television stations,
          plus proposed NJ PBS LPTV contours that are awaiting FCC approval.
        </desc>

        <defs>
          <filter id="coverage-glow" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <rect class="coverage-map__water" width="100%" height="100%" rx="18" />

        <g class="coverage-map__states" aria-hidden="true">
          {coverageStateShapes.filter((state) => state.id !== "nj").map((state) => (
            <path class="coverage-state" d={state.path} />
          ))}
          <g class="coverage-map__nj-edge">
            {officialNjCountyShapes.map((county) => <path d={county.path} />)}
          </g>
          <g class="coverage-map__nj-land">
            {officialNjCountyShapes.map((county) => <path d={county.path} />)}
          </g>
          <text class="coverage-state-label" x="78" y="426">PA.</text>
          <text class="coverage-state-label" x="678" y="110">N.Y.</text>
          <text class="coverage-state-label coverage-state-label--nj" x="520" y="610">N.J.</text>
          <text class="coverage-state-label" x="178" y="850">DEL.</text>
        </g>

        <g class="coverage-map__counties" aria-hidden="true">
          {officialNjCountyShapes.map((county) => <path d={county.path}><title>{county.name} County</title></path>)}
        </g>

        <g class="coverage-map__places" aria-hidden="true">
          {coveragePlaceLabels.map((place) => (
            <g>
              <circle cx={place.x} cy={place.y} r="2.5" />
              <text
                x={place.x + (place.anchor === "start" ? 8 : -8)}
                y={place.y + 4}
                text-anchor={place.anchor}
              >
                {place.label}
              </text>
            </g>
          ))}
        </g>

        <g class="coverage-map__contours">
          {drawOrder.map((site, index) => (
            <path
              class:list={["coverage-contour", `coverage-tone--${site.category}`]}
              d={site.contourPath}
              pathLength="1"
              data-site-id={site.id}
              data-site-category={site.category}
              aria-hidden="true"
              style={`--coverage-delay: ${index * 55}ms`}
            >
              <title>
                {site.callsigns.join(" / ")} {site.category === "nj-coming"
                  ? "proposed coverage estimate, awaiting FCC approval"
                  : "FCC protected service contour"}
              </title>
            </path>
          ))}
        </g>

        <g class="coverage-map__sites">
          {coverageSites.map((site) => (
            <g
              class:list={["coverage-site", `coverage-tone--${site.category}`]}
              data-site-id={site.id}
              data-site-category={site.category}
              data-map-marker
              aria-hidden="true"
            >
              <title>{site.callsigns.join(" / ")} transmitter site</title>
              <circle class="coverage-site__halo" cx={site.x} cy={site.y} r="14" />
              {site.category === "nj-low" ? (
                <g transform={`rotate(45 ${site.x} ${site.y})`}>
                  <rect
                    class="coverage-site__point"
                    x={site.x - 6}
                    y={site.y - 6}
                    width="12"
                    height="12"
                  />
                </g>
              ) : site.category === "nj-coming" ? (
                <rect
                  class="coverage-site__point coverage-site__point--proposed"
                  x={site.x - 6}
                  y={site.y - 6}
                  width="12"
                  height="12"
                  rx="2"
                />
              ) : (
                <circle class="coverage-site__point" cx={site.x} cy={site.y} r="6.5" />
              )}
              <text x={site.x + site.labelDx} y={site.y + site.labelDy}>{site.label}</text>
            </g>
          ))}
        </g>
      </svg>

      <figcaption>
        Solid shapes are current FCC protected service contours. Dashed orange shapes are proposed
        NJ PBS low-power TVStudy predictions awaiting FCC approval. Overlap shows places that could receive
        more than one public television signal.
      </figcaption>
    </figure>

    <aside class="coverage__panel" aria-label="Transmitter details">
      <p class="coverage__eyebrow">Selected station</p>
      <div class="coverage__selected" data-selected-tone={initialSite.category} aria-live="polite">
        <h2 data-selected-calls>{initialSite.callsigns.join(" · ")}</h2>
        <p class="coverage__network" data-selected-network>{initialSite.network}</p>
        <p data-selected-communities>{initialSite.communities.join(" · ")}</p>
        <dl>
          <div>
            <dt>Service</dt>
            <dd data-selected-service>{categoryLabels[initialSite.category]}</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd data-selected-status>On air</dd>
          </div>
          <div>
            <dt>Broadcast channel (RF)</dt>
            <dd data-selected-channel>{initialSite.channel}</dd>
          </div>
          <div>
            <dt>Estimated signal reach</dt>
            <dd data-selected-radius>{initialSite.radiusMinMiles}–{initialSite.radiusMaxMiles} miles</dd>
          </div>
          <div data-selected-facility-row>
            <dt>FCC facility ID</dt>
            <dd data-selected-facilities>{initialSite.facilityIds.join(" · ")}</dd>
          </div>
        </dl>
        <div class="coverage__fcc-links" data-selected-links>
          {initialSite.facilityIds.map((facilityId) => (
            <a class="coverage__fcc-link" href={fccFacilityUrl(facilityId)} rel="noopener" target="_blank">
              FCC record {facilityId}<span class="sr-only"> (opens in new tab)</span>
            </a>
          ))}
        </div>
      </div>

      <p class="coverage__list-label" id="coverage-site-list-label">
        Choose another station <span>Scroll to see all</span>
      </p>
      <div class="coverage__site-list" role="region" aria-labelledby="coverage-site-list-label">
        {coverageSites.map((site) => (
          <button
            type="button"
            class:list={["coverage-site-button", `coverage-tone--${site.category}`]}
            data-site-id={site.id}
            data-site-category={site.category}
            data-site-control
            aria-label={`Select ${site.callsigns.join(" and ")}, ${site.communities.join(" and ")}`}
            aria-pressed={site.id === initialSite.id ? "true" : "false"}
          >
            <span class="coverage-site-button__dot" aria-hidden="true"></span>
            <span>
              <strong>{site.callsigns.join(" · ")}</strong>
              <small>{site.communities.join(" · ")}</small>
            </span>
          </button>
        ))}
      </div>
    </aside>
  </div>

  <div class="coverage__key" aria-label="Map key">
    <p><span class="key-mark key-mark--full"></span><strong>NJ PBS full power</strong> Four station licenses at two shared sites</p>
    <p><span class="key-mark key-mark--low"></span><strong>On-air NJ PBS low-power TV (LPTV)</strong> Three translators serving northwestern New Jersey</p>
    <p><span class="key-mark key-mark--coming"></span><strong>Proposed NJ PBS low-power TV (LPTV)</strong> Nine sites awaiting FCC approval</p>
    <p><span class="key-mark key-mark--neighbor"></span><strong>Neighbor overlap</strong> WHYY, WNET and Lehigh Valley Public Media</p>
  </div>

  <details class="coverage__directory">
    <summary>Station details and FCC records</summary>
    <div class="coverage__table-wrap">
      <table class="coverage__records-table">
        <caption>Station licenses represented on the coverage map</caption>
        <thead>
          <tr>
            <th scope="col">Station or site</th>
            <th scope="col">Service</th>
            <th scope="col">Community</th>
            <th scope="col">RF</th>
            <th scope="col">Contour reach</th>
            <th scope="col">FCC record</th>
          </tr>
        </thead>
        <tbody>
          {tableRows.map((row) => (
            <tr>
              <th scope="row">{row.callsign}</th>
              <td>{row.service}</td>
              <td>{row.community}</td>
              <td>{row.channel}</td>
              <td>{row.radius}</td>
              <td>{row.facilityId ? <a href={fccFacilityUrl(row.facilityId)} rel="noopener" target="_blank">{row.facilityId}<span class="sr-only"> (opens in new tab)</span></a> : "Awaiting approval"}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <ul class="coverage__record-cards">
        {tableRows.map((row) => (
          <li>
            <strong>{row.callsign}</strong>
            <dl>
              <div><dt>Service</dt><dd>{row.service}</dd></div>
              <div><dt>Community</dt><dd>{row.community}</dd></div>
              <div><dt>RF</dt><dd>{row.channel}</dd></div>
              <div><dt>Contour reach</dt><dd>{row.radius}</dd></div>
              <div>
                <dt>FCC record</dt>
                <dd>{row.facilityId ? <a href={fccFacilityUrl(row.facilityId)} rel="noopener" target="_blank">{row.facilityId}<span class="sr-only"> (opens in new tab)</span></a> : "Awaiting approval"}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </details>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-coverage-map]");
    if (!root) return;

    var sites = JSON.parse(root.getAttribute("data-sites") || "[]");
    var categoryNames = JSON.parse(root.getAttribute("data-category-labels") || "{}");
    var siteById = new Map(sites.map(function (site) { return [site.id, site]; }));
    var svg = root.querySelector("[data-coverage-svg]");
    var baseWidth = 850;
    var baseHeight = 980;
    var zoomLevels = [1, 1.28, 1.62];
    var zoomIndex = 0;
    var selectedId = sites[0] && sites[0].id;
    var hasExplicitSelection = false;

    function matchesFilter(category, filter) {
      if (filter === "all") return true;
      if (filter === "nj") return category.indexOf("nj-") === 0;
      if (filter === "neighbors") return category.indexOf("neighbor-") === 0;
      return category === filter;
    }

    function currentFilter() {
      var active = root.querySelector("[data-coverage-filter][aria-pressed='true']");
      return active ? active.getAttribute("data-coverage-filter") : "all";
    }

    function updateDetails(site) {
      root.querySelector("[data-selected-calls]").textContent = site.callsigns.join(" · ");
      root.querySelector("[data-selected-network]").textContent = site.network;
      root.querySelector("[data-selected-communities]").textContent = site.communities.join(" · ");
      root.querySelector("[data-selected-service]").textContent = categoryNames[site.category];
      root.querySelector("[data-selected-status]").textContent = site.category === "nj-coming" ? "Proposed · Awaiting FCC approval" : "On air";
      root.querySelector("[data-selected-channel]").textContent = String(site.channel);
      root.querySelector("[data-selected-radius]").textContent = site.radiusMinMiles + "–" + site.radiusMaxMiles + " miles";
      root.querySelector("[data-selected-facilities]").textContent = site.facilityIds.join(" · ");
      root.querySelector("[data-selected-tone]").setAttribute("data-selected-tone", site.category);
      var facilityRow = root.querySelector("[data-selected-facility-row]");
      var facilityLinks = root.querySelector("[data-selected-links]");
      var hasFacility = site.facilityIds.length > 0;
      if (facilityRow) facilityRow.hidden = !hasFacility;
      if (facilityLinks) {
        facilityLinks.replaceChildren();
        site.facilityIds.forEach(function (facilityId) {
          var link = document.createElement("a");
          link.className = "coverage__fcc-link";
          link.href = "https://enterpriseefiling.fcc.gov/dataentry/public/tv/publicFacilityDetails.html?facilityId=" + facilityId;
          link.rel = "noopener";
          link.target = "_blank";
          link.appendChild(document.createTextNode("FCC record " + facilityId));
          var newTabCue = document.createElement("span");
          newTabCue.className = "sr-only";
          newTabCue.textContent = " (opens in new tab)";
          link.appendChild(newTabCue);
          facilityLinks.appendChild(link);
        });
      }
    }

    function setViewBox() {
      if (!svg) return;
      var scale = zoomLevels[zoomIndex];
      var width = baseWidth / scale;
      var height = baseHeight / scale;
      var selected = siteById.get(selectedId);
      var centerX = selected && scale > 1 ? selected.x : baseWidth / 2;
      var centerY = selected && scale > 1 ? selected.y : baseHeight / 2;
      var x = Math.max(0, Math.min(baseWidth - width, centerX - width / 2));
      var y = Math.max(0, Math.min(baseHeight - height, centerY - height / 2));
      svg.setAttribute("viewBox", [x, y, width, height].join(" "));
      var status = root.querySelector("[data-map-zoom-status]");
      if (status) status.textContent = "Map zoom " + Math.round(scale * 100) + "%";
      var out = root.querySelector("[data-map-zoom='out']");
      var inside = root.querySelector("[data-map-zoom='in']");
      if (out) out.disabled = zoomIndex === 0;
      if (inside) inside.disabled = zoomIndex === zoomLevels.length - 1;
    }

    function selectSite(id, emphasize) {
      var site = siteById.get(id);
      if (!site) return;
      selectedId = id;
      hasExplicitSelection = emphasize === true;
      root.querySelectorAll("[data-site-id]").forEach(function (element) {
        var selected = element.getAttribute("data-site-id") === id;
        element.toggleAttribute("data-selected", selected);
        if (element.hasAttribute("data-site-control")) {
          element.setAttribute("aria-pressed", selected ? "true" : "false");
        }
        if (element.classList.contains("coverage-contour")) {
          element.toggleAttribute("data-muted", hasExplicitSelection && !selected);
        }
      });
      updateDetails(site);
      setViewBox();
    }

    function setFilter(filter) {
      root.querySelectorAll("[data-coverage-filter]").forEach(function (button) {
        button.setAttribute(
          "aria-pressed",
          button.getAttribute("data-coverage-filter") === filter ? "true" : "false",
        );
      });
      root.querySelectorAll("[data-site-category]").forEach(function (element) {
        var visible = matchesFilter(element.getAttribute("data-site-category"), filter);
        element.toggleAttribute("hidden", !visible);
      });
      var selected = siteById.get(selectedId);
      if (!selected || !matchesFilter(selected.category, filter)) {
        var first = sites.find(function (site) { return matchesFilter(site.category, filter); });
        if (first) selectSite(first.id, false);
      } else {
        selectSite(selectedId, false);
      }
    }

    root.querySelectorAll("[data-coverage-filter]").forEach(function (button) {
      button.addEventListener("click", function () {
        setFilter(button.getAttribute("data-coverage-filter"));
      });
    });

    root.querySelectorAll(".coverage-contour, [data-site-control], [data-map-marker]").forEach(function (control) {
      control.addEventListener("click", function () {
        selectSite(control.getAttribute("data-site-id"), true);
      });
    });

    root.querySelectorAll("[data-map-zoom]").forEach(function (button) {
      button.addEventListener("click", function () {
        var action = button.getAttribute("data-map-zoom");
        if (action === "in") zoomIndex = Math.min(zoomLevels.length - 1, zoomIndex + 1);
        if (action === "out") zoomIndex = Math.max(0, zoomIndex - 1);
        if (action === "reset") zoomIndex = 0;
        setViewBox();
      });
    });

    var fullscreenButton = root.querySelector("[data-map-fullscreen]");
    function updateFullscreenButton() {
      if (!fullscreenButton) return;
      var active = document.fullscreenElement === root;
      fullscreenButton.textContent = active ? "Exit full screen" : "Full screen";
      fullscreenButton.setAttribute("aria-pressed", active ? "true" : "false");
    }
    if (!document.fullscreenEnabled || !root.requestFullscreen) {
      if (fullscreenButton) fullscreenButton.hidden = true;
    } else {
      fullscreenButton.addEventListener("click", function () {
        var action = document.fullscreenElement === root
          ? document.exitFullscreen()
          : root.requestFullscreen();
        if (action && typeof action.catch === "function") action.catch(function () {});
      });
      document.addEventListener("fullscreenchange", updateFullscreenButton);
    }

    setFilter(currentFilter());
    selectSite(selectedId, false);
    updateFullscreenButton();
  })();
</script>

<style>
  .coverage {
    width: min(calc(100% - 2rem), var(--wrap));
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.5rem) 0 clamp(3rem, 7vw, 6rem);
    box-sizing: border-box;
  }

  .coverage__guide,
  .coverage__toolbar,
  .coverage__filters,
  .coverage__zoom,
  .coverage__grid,
  .coverage__figure,
  .coverage__panel,
  .coverage__selected,
  .coverage__site-list,
  .coverage__key,
  .coverage__directory,
  .coverage__table-wrap {
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
  }

  .coverage__guide {
    margin-bottom: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-accent);
    background: var(--color-surface-panel);
  }
  .coverage__guide h2 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }
  .coverage__guide ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .coverage__guide li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }
  .coverage__guide li span {
    display: grid;
    flex: 0 0 2rem;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-map-control-active);
    color: var(--color-text-on-surface);
    font-weight: 850;
  }

  .coverage__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .coverage__filters,
  .coverage__zoom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .coverage-filter,
  .coverage__zoom button {
    min-height: var(--target-comfortable);
    border: 1px solid var(--color-border-strong);
    border-radius: 3.75px;
    background: var(--color-surface-panel);
    color: var(--color-text-muted);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition:
      color var(--motion-duration-fast) var(--motion-ease-standard),
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      background var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .coverage-filter { padding: 0.55rem 1rem; }
  .coverage__zoom button { min-width: var(--target-comfortable); padding: 0.45rem 0.8rem; }
  .coverage-filter:hover,
  .coverage__zoom button:hover { color: var(--color-text-on-surface); }
  .coverage-filter[aria-pressed="true"] {
    border-color: var(--color-map-nj-full);
    background: var(--color-map-control-active);
    color: var(--color-text-on-surface);
  }
  .coverage-filter:focus-visible,
  .coverage__zoom button:focus-visible,
  .coverage-site-button:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
  }
  .coverage__zoom button:disabled { cursor: default; opacity: 0.42; }

  .coverage__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 0.8fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
