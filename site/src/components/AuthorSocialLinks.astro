---
// The author's social links, as icons only.
//
// Each icon link's accessible name carries what a sighted reader gets from
// the glyph plus the
// fact that it leaves the site -- the author's name, the platform, and this
// repo's new-tab cue, which the post-build guardrail requires inside the
// accessible name of every `target="_blank"` anchor.
//
// The glyphs are inline SVG with `aria-hidden`, so the accessible name comes
// from the visually hidden span alone and never from a duplicated title.

interface Props {
  displayName: string;
  links: readonly { platform: "x" | "bluesky" | "linkedin"; url: string }[];
}

const { displayName, links } = Astro.props as Props;

const PLATFORM_LABELS: Record<Props["links"][number]["platform"], string> = {
  x: "X",
  bluesky: "Bluesky",
  linkedin: "LinkedIn",
};
---

{links.length > 0 && (
  <ul class="author-social">
    {links.map((link) => (
      <li>
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer me"
          class="author-social__link"
        >
          <span class="author-social__glyph" aria-hidden="true">
            {link.platform === "x" && (
              <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
                <path
                  fill="currentColor"
                  d="M17.53 3h3.02l-6.6 7.54L21.75 21h-5.94l-4.65-6.08L5.8 21H2.78l7.06-8.07L2.25 3h6.09l4.2 5.56L17.53 3Zm-1.06 16.2h1.67L7.6 4.71H5.81l10.66 14.49Z"
                />
              </svg>
            )}
            {link.platform === "bluesky" && (
              <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
                <path
                  fill="currentColor"
                  d="M12 10.8C10.94 8.73 8.03 4.88 5.33 3.0 2.74 1.2 1.75 1.51 1.1 1.8.35 2.14.22 3.29.22 3.97c0 .68.37 5.57.62 6.39.8 2.7 3.66 3.62 6.29 3.33.13-.02.27-.04.41-.05-.14.02-.28.04-.41.05-3.85.57-7.28 1.97-2.79 6.97 4.94 5.1 6.77-1.09 7.7-4.23.93 3.14 2.01 9.11 7.59 4.23 4.2-4.23 1.15-6.4-2.7-6.97-.14-.01-.28-.03-.41-.05.14.01.27.03.41.05 2.63.29 5.49-.63 6.29-3.33.25-.82.62-5.71.62-6.39 0-.68-.13-1.83-.88-2.17-.65-.29-1.64-.6-4.23 1.2-2.7 1.88-5.61 5.73-6.67 7.8Z"
                />
              </svg>
            )}
            {link.platform === "linkedin" && (
              <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
                <path
                  fill="currentColor"
                  d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6.5 0h3.83v1.64h.05c.53-.96 1.83-1.97 3.77-1.97 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.7c0-1.36-.02-3.11-1.95-3.11-1.95 0-2.25 1.48-2.25 3.01V21h-4V9Z"
                />
              </svg>
            )}
          </span>
          <span class="visually-hidden">
            {displayName} on {PLATFORM_LABELS[link.platform]} (opens in new tab)
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .author-social {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .author-social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: var(--target-comfortable);
    min-height: var(--target-comfortable);
    border: 1px solid var(--line);
    border-radius: 15px;
    color: var(--text);
    text-decoration: none;
  }

  .author-social__link:hover {
    border-color: var(--line-strong);
    color: var(--color-link);
  }

  .author-social__glyph {
    display: inline-flex;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
