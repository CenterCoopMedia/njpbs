---
import { READER_TEXT_SIZES } from "../lib/reader-text-size.js";
import { readerTextSizeEnabled } from "../lib/reader-text-size-policy";
import "../styles/reader-text-size.css";
interface Props { within?: "data-hub" }
const { within } = Astro.props;
const names = { standard: "Standard text size", large: "Large text size", largest: "Largest text size" };
---

{readerTextSizeEnabled(Astro.url.pathname, Astro.locals.readerTextSizeDisabled) && <>
<div class:list={["reader-text-size", { "reader-text-size--inset": within }]} data-reader-text-size-picker data-reader-within={within} hidden>
  <fieldset class="reader-text-size__group">
    <legend>Text size</legend>
    <div class="reader-text-size__choices">
      {READER_TEXT_SIZES.map(size => (
        <label class={`reader-text-size__choice reader-text-size__choice--${size}`} title={names[size]}>
          <input type="radio" name="reader-text-size" value={size} aria-label={names[size]} checked={size === "standard"} />
          <span aria-hidden="true">A</span>
        </label>
      ))}
    </div>
  </fieldset>
</div>

</>}

<script>
  // Register the asset in the client graph so saved previews package it too.
  // Only load the preference module when an eligible picker was rendered.
  if (document.querySelector("[data-reader-text-size-picker]")) {
    import("../lib/reader-text-size.js?url&no-inline").then(({ default: readerScriptUrl }) => {
      const script = document.createElement("script");
      script.type = "module";
      script.src = readerScriptUrl;
      document.head.append(script);
    });
  }
</script>
