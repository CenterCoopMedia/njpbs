const detail = details[page.slug] ?? {
  summary: page.description,
  cards: [
    {
      title: page.primaryAction.label,
      label: "Open",
      description: page.description,
      href: page.primaryAction.href,
      external: page.primaryAction.external,
    },
  ],
};

const cardGridClass = [
  "public-page__cards",
  (cmsService?.cards.length ?? detail.cards.length) === 4
    ? "public-page__cards--four"
    : "",
]
  .filter(Boolean)
  .join(" ");

const hasMedia = Boolean(detail.player || detail.scheduleWidget);

// The giving-family pages (/give/, /support/, /passport/, /donate/) carry a static
// transition notice near the top so the donation-cutoff and Passport guidance
// reach people at the moment of action, not only on /faq/.
const showTransitionNotice = (
  transitionNoticeSlugs as readonly string[]
).includes(page.slug);

// The PBS JAWS widget embed. gc.js reads PBS_CHROME_CONFIG (which must exist
// before it loads) and renders the declared widget into its placeholder id. Both
// tags are is:inline so Astro emits them verbatim instead of bundling them. The
// config is built by the shared module so the single-widget rule is testable.
const scheduleWidgetConfig = buildScheduleWidgetConfig();

const articleClass = [
  "public-page",
  detail.player ? "public-page--with-player" : "",
  detail.scheduleWidget ? "public-page--with-schedule" : "",
  page.destinationCards
    ? "public-page--wide-cards"
    : "",
]
  .filter(Boolean)
  .join(" ");
---

<article
  class={cmsService ? servicePageClass(cmsService.page) : articleClass}
  data-cms-service-page={cmsService ? page.slug : undefined}
>
  {pageTheme === "nj-decides" ? <>
    <NjDecidesPageHeading title={cmsService?.page.title ?? page.title} description={electionHeading ? electionHeading.description : page.description} />
    {electionHeading?.actionsHtml && <div class="public-page__themed-actions"><Fragment set:html={electionHeading.actionsHtml} /></div>}
  </> : <section
    class:list={[
      "public-page__hero",
      { "cms-hero-surface": Boolean(heroBackgroundImage) },
    ]}
  >
    <CmsHeroBackground
      image={heroBackgroundImage}
      position={heroBackgroundPosition}
    />
    <div>
      <h1>{cmsService?.page.title ?? page.title}</h1>
      {
        cmsService && cmsService.page.slug !== "live" ? (
          <Fragment set:html={renderServiceIntroduction(cmsService)} />
        ) : !hasMedia && !cmsService && (
          <>
            <p>{detail.summary}</p>
            <div class="public-page__actions">
              <a
                class="btn btn--primary"
                href={page.primaryAction.href}
                {...(opensInNewTab(page.primaryAction) ? { rel: "noopener", target: "_blank" } : {})}
              >
                {page.primaryAction.label}
                {opensInNewTab(page.primaryAction) && <span class="sr-only"> (opens in new tab)</span>}
              </a>
              {page.secondaryAction && (
                <a
                  class="btn btn--ghost"
                  href={page.secondaryAction.href}
                  {...(opensInNewTab(page.secondaryAction) ? { rel: "noopener", target: "_blank" } : {})}
                >
                  {page.secondaryAction.label}
                  {opensInNewTab(page.secondaryAction) && <span class="sr-only"> (opens in new tab)</span>}
                </a>
              )}
            </div>
          </>
        )
      }
    </div>
  </section>}

  <ReaderTextSize />

  {
    showTransitionNotice && !cmsService && (
      <aside class="public-page__notice" aria-label={givingTransitionNotice.heading}>
        <div class="public-page__notice-inner">
          <h2>{givingTransitionNotice.heading}</h2>
          {givingTransitionNotice.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="public-page__notice-link">
            {givingTransitionNotice.links.map((link, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a
                  href={link.href}
                  rel={link.external ? "noopener" : undefined}
                  target={link.external ? "_blank" : undefined}
                >
                  {link.label}
                  {link.external && <span class="sr-only"> (opens in new tab)</span>}
                </a>
              </>
            ))}
          </p>
        </div>
      </aside>
    )
  }

  {cmsService && <Fragment set:html={renderServiceNotice(cmsService)} />}

  {/* Cross-origin player failures cannot be detected here. Keep both live
      alternatives visible even when PBS rejects or cannot load the embed. */}
  {detail.player && <Fragment set:html={renderLivePlayerFrame()} />}

  {
    page.slug === "live" && (
      <ScheduleNowNext days={bakedSchedule.days.broadcast} variant="compact" />
    )
  }

  {
    detail.scheduleWidget && (
      <>
        <section
          class="public-page__schedule-section"
          aria-label={detail.scheduleWidget.heading}
        >
          <figure class="public-page__schedule">
            <p class="public-page__schedule-help">{detail.scheduleWidget.help}</p>

            <div class="public-page__schedule-block">
              <h2 class="public-page__schedule-label">Full week grid</h2>
              <div class="public-page__schedule-frame">
                <div id="tvschedule">
                  <p class="public-page__schedule-fallback">
                    Live TV listings load here. If they do not appear, watch the{" "}
                    <a href="/live/">NJ PBS livestream</a> or browse{" "}
                    <a href={pbsVideoUrl} rel="noopener" target="_blank">
                      video on demand<span class="sr-only"> (opens in new tab)</span>
                    </a>
                    .
                  </p>
                </div>
              </div>
            </div>

            {/* Persistent, empty live region: kept in the a11y tree so setting
                its text on failure fires a screen-reader announcement, which
                un-hiding a pre-filled region does not do reliably. */}
            <p class="sr-only" data-schedule-announce role="status" aria-live="polite" />

            <div class="public-page__schedule-status" data-schedule-fallback hidden>
              <p>
                Live TV listings are temporarily unavailable. Watch the{" "}
                <a href="/live/">NJ PBS livestream</a> or browse{" "}
                <a href={pbsVideoUrl} rel="noopener" target="_blank">
                  video on demand<span class="sr-only"> (opens in new tab)</span>
                </a>
                .
              </p>
            </div>

            <figcaption>{detail.scheduleWidget.caption}</figcaption>
          </figure>
        </section>
        <script is:inline set:html={scheduleWidgetConfig} />
        <script is:inline src={SCHEDULE_WIDGET_SRC} data-schedule-loader />
        <script>
          import {
            applyScheduleWidgetStatus,
            isWidgetRendered,
            resolveScheduleWidgetStatus,
            SCHEDULE_RENDER_DEADLINE_MS,
          } from "../lib/schedule-widget-health";

          // gc.js renders the PBS schedule grid into its placeholder at runtime. If it
          // fails to load, or loads but its upstream PBS fetch fails and leaves the
          // placeholder empty, hide the dead grid block and reveal the honest
          // fallback (livestream and video-on-demand links) instead of a blank box.
          const mount = document.getElementById("tvschedule");
          const block = mount?.closest<HTMLElement>(
            ".public-page__schedule-block",
          );
          const fallback = document.querySelector<HTMLElement>(
            "[data-schedule-fallback]",
          );
          const announcer = document.querySelector<HTMLElement>(
            "[data-schedule-announce]",
          );
          const loader = document.querySelector<HTMLScriptElement>(
            "[data-schedule-loader]",
          );

          if (mount && block && fallback) {
            let loaderErrored = false;
            let deadlineReached = false;
            let deadline = 0;
            let observer: MutationObserver;

            // Reconcile the frame to the widget's current state, and keep it honest
            // as that state changes. applyScheduleWidgetStatus owns the status-to-DOM
            // policy (reveal the grid, reveal the fallback, announce once, clear on
            // recovery) and reports when the widget has settled; only then do we drop
            // the observer and timeout. It reports not-settled for a deadline-driven
            // "unavailable" so a slow gc.js that renders afterward (a slow mobile
            // connection, PBS answering late) still flips the page back to the grid.
            const reconcile = () => {
              const status = resolveScheduleWidgetStatus({
                loaderErrored,
                widgetRendered: isWidgetRendered(mount),
                deadlineReached,
              });
              const settled = applyScheduleWidgetStatus(status, {
                block,
                fallback,
                announcer,
              });
              if (settled) {
                observer.disconnect();
                window.clearTimeout(deadline);
              }
            };

            // gc.js renders listings by adding nodes or by marking an existing
            // scaffold with data-program-title; watch both paths so a render at
            // any time, including after the deadline, reconciles.
            observer = new MutationObserver(reconcile);
            observer.observe(mount, {
              childList: true,
              subtree: true,
              attributes: true,
              attributeFilter: ["data-program-title"],
            });

            // Fast path: a failed load fires an error event. Best-effort, because
            // this module is deferred and gc.js is inline, so gc.js may already
            // have settled before this listener attaches. The deadline is the
            // backstop, and the observer catches a late render either way.
            loader?.addEventListener("error", () => {
              loaderErrored = true;
              reconcile();
            });

            deadline = window.setTimeout(() => {
              deadlineReached = true;
              reconcile();
            }, SCHEDULE_RENDER_DEADLINE_MS);

            // gc.js is inline and may have rendered before this deferred module
            // ran, which fires no mutation; check once now so an already-loaded
            // grid resolves immediately instead of waiting out the deadline.
            reconcile();
          }
        </script>
      </>
    )
  }

  {cmsService ? <Fragment set:html={renderServiceBody(cmsService)} /> : <section class="public-page__body" aria-label={`${page.title} details`}>
    <div class="public-page__copy">
      {(
        <>
          {hasMedia && <p class="public-page__summary">{detail.summary}</p>}
          {hasMedia && (
            <div class="public-page__actions public-page__actions--below">
              <a class="btn btn--primary" href={page.primaryAction.href}
                {...(opensInNewTab(page.primaryAction) ? { rel: "noopener", target: "_blank" } : {})}>
                {page.primaryAction.label}
                {opensInNewTab(page.primaryAction) && <span class="sr-only"> (opens in new tab)</span>}
              </a>
              {page.secondaryAction && (
                <a class="btn btn--ghost" href={page.secondaryAction.href}
                  {...(opensInNewTab(page.secondaryAction) ? { rel: "noopener", target: "_blank" } : {})}>
                  {page.secondaryAction.label}
                  {opensInNewTab(page.secondaryAction) && <span class="sr-only"> (opens in new tab)</span>}
                </a>
              )}
            </div>
          )}
          {page.body.map((paragraph) => <p>{paragraph}</p>)}
          {detail.sections?.map((section) => (
            <section class="public-page__section">
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
              {section.actions && (
                <p class="public-page__section-links">
                  {section.actions.map((action) => (
                    <a href={action.href}
                      {...(opensInNewTab(action) ? { rel: "noopener", target: "_blank" } : {})}>
                      {action.label}
                      {opensInNewTab(action) && <span class="sr-only"> (opens in new tab)</span>}
                    </a>
                  ))}
                </p>
              )}
            </section>
          ))}
          {detail.note && <p class="public-page__note">{detail.note}</p>}
        </>
      )}
    </div>
    {page.destinationCards && <div class="public-page__side">
      <div class={cardGridClass}>
        {
          !cmsService &&
            detail.cards.map((card) => (
              <a
                class="public-page__card"
                href={card.href}
                {...(opensInNewTab(card)
                  ? { rel: "noopener", target: "_blank" }
                  : {})}
              >
                {card.image && (
                  <span class="public-page__card-media" aria-hidden="true">
                    <img
                      class="public-page__card-image"
                      src={card.image}
                      alt=""
                      loading="lazy"
                      width="640"
                      height="360"
                    />
                  </span>
                )}
                <span class="public-page__card-label">{card.label}</span>
                <strong>{card.title}</strong>
                <em>{card.description}</em>
                {opensInNewTab(card) && (
                  <span class="sr-only"> (opens in new tab)</span>
                )}
              </a>
            ))
        }
      </div>
    </div>}
  </section>}
</article>

<style>
  .public-page__themed-actions { max-width: var(--wrap); margin-inline: auto; padding: 1.25rem var(--gutter) 0; }
</style>
