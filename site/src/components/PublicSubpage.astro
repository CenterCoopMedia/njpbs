---
import ReaderTextSize from "./ReaderTextSize.astro";
import {
  donateUrl,
  givingTransitionNotice,
  passportLearnMoreUrl,
  passportLookupUrl,
  pbsAppUrl,
  pbsKidsUrl,
  pbsLivestreamEmbedUrl,
  pbsVideoUrl,
  transitionNoticeSlugs,
  type LaunchFallbackPage,
  type LaunchLink,
} from "../data/launch-fallback";
import {
  buildScheduleWidgetConfig,
  SCHEDULE_WIDGET_SRC,
} from "../lib/schedule-widget";
import { renderLivePlayerFrame } from "../lib/live-player-render";
import { HOMEPAGE_ANNOUNCEMENT } from "../lib/homepage-announcement";
import ScheduleNowNext from "./ScheduleNowNext.astro";
import scheduleData from "../data/schedule.json";
import { renderSchedule } from "../lib/cms-render-context";
import type { BakedScheduleData } from "../lib/schedule-feed";
import { loadScheduleData } from "../lib/schedule-data";
import type { CmsServicePageProjection } from "../lib/cms-service-page";
import { renderServiceIntroduction, renderServiceNotice, renderServiceBody, servicePageClass } from "../lib/cms-service-render";
import { njDecidesServiceHeading } from "../../../packages/content-core/src/nj-decides-page";
import NjDecidesPageHeading from "./NjDecidesPageHeading.astro";
import type { PageTheme } from "../../../packages/content-core/src/content-model";
import CmsHeroBackground from "./CmsHeroBackground.astro";
import "../styles/service-page.css";

interface Props {
  page: LaunchFallbackPage;
  pageTheme?: PageTheme;
  cmsService?: CmsServicePageProjection;
  heroBackgroundImage?: {
    url: string;
    width: number;
    height: number;
  } | null;
  heroBackgroundPosition?: "center" | "top" | "bottom";
}

interface DetailCard extends LaunchLink {
  title: string;
  description: string;
  image?: string;
}

// An optional headed prose section under the page copy. Gives a page like /about
// real information structure (scannable h2s) without changing the shared
// LaunchFallbackPage shape. `actions` render as text links after the prose.
interface DetailSection {
  heading: string;
  body: string[];
  actions?: LaunchLink[];
}

// The PBS JAWS schedule widget. Rendered like a player: an embed section between
// the hero and the body. gc.js reads the global PBS_CHROME_CONFIG and injects the
// full week grid into its placeholder at runtime, so the page ships static fallback
// content for no-JS and failed loads rather than linking out to the PBS station
// schedule router (which redirects back to this page and loops). It is one widget
// by design: gc.js reloads jQuery once per declared widget, and a second widget
// broke the grid's datepicker (see src/lib/schedule-widget.ts). gc.js also injects
// PBS's own site masthead as #jaws_header; the schedule styles hide it since we
// only want the listings, not PBS chrome.
interface PageSchedule {
  heading: string;
  help: string;
  caption: string;
}

interface PageDetails {
  summary: string;
  player?: true;
  scheduleWidget?: PageSchedule;
  cards: DetailCard[];
  sections?: DetailSection[];
  note?: string;
}

const {
  page,
  pageTheme,
  cmsService,
  heroBackgroundImage,
  heroBackgroundPosition,
} = Astro.props as Props;
const electionHeading = cmsService ? njDecidesServiceHeading(cmsService) : undefined;
const bakedSchedule = renderSchedule(Astro.locals.cmsRender)?.data ?? await loadScheduleData(scheduleData as BakedScheduleData);
const opensInNewTab = (link: LaunchLink) =>
  link.external === true && /^https?:\/\//.test(link.href);

const details: Record<string, PageDetails> = {
