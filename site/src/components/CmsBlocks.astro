---
import "../../../packages/content-core/src/component-blocks.css";
import "../../../packages/content-core/src/link-card.css";
import "../../../packages/content-core/src/document-list.css";
import "../../../packages/content-core/src/link-card-directory.css";
import { getCollection, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { renderContentGroups } from "../../../packages/content-core/src/content-row-render";
import { visibleLayoutBlocks } from "../../../packages/content-core/src/content-layout";
import {
  generatedHeadingLevelAt,
  renderBlock,
} from "../../../packages/content-core/src/content-render";
import {
  resolveCmsResponsiveAssets,
  responsiveImageKey,
} from "../lib/cms-responsive-image";
import { groupLinkCardDirectories } from "../../../packages/content-core/src/link-card-directory-groups";
import LinkCardDirectory from "./LinkCardDirectory.astro";
import CmsBlockGroup from "./CmsBlockGroup.astro";
import ReaderTextSize from "./ReaderTextSize.astro";
import { sponsorCardsFromRecordCards } from "../lib/record-card-resolution";
import { newsletterSignupResolution } from "../lib/newsletter-signup";
import { usesServiceComposition } from "../../../packages/content-core/src/service-composition";
import { renderDatasetFigures, renderRecordCards } from "../lib/cms-render-context";

interface Props {
  entry: CollectionEntry<"cmsPages">;
  excludeTypes?: readonly string[];
  contained?: boolean;
  readerControls?: boolean;
  resolveDataHubSection?: import("../../../packages/content-core/src/content-render").RenderBlockOptions["resolveDataHubSection"];
}

const { entry, excludeTypes = [], contained = true, readerControls = false, resolveDataHubSection } = Astro.props as Props;
const blocks = entry.data.blocks.filter((block) => !excludeTypes.includes(block.type));
const collectedCards = Astro.locals.cmsRender ? [] : (await getCollection("cmsRecordCards")).map(item => item.data);
const recordCards = renderRecordCards(Astro.locals.cmsRender, collectedCards).filter(card =>
  entry.data.pageId !== "kids" || card.kind !== "newsletter");
const sponsors = sponsorCardsFromRecordCards(recordCards);
const resolveDataFigure = renderDatasetFigures(entry.data.datasetFigures);
const responsiveAssets = await resolveCmsResponsiveAssets(
  blocks,
  entry.data.assets,
  getImage,
);
const newsletters = await newsletterSignupResolution(blocks, getImage, recordCards);
let privacyChoicesAnchorAssigned = false;
const privacyChoicesHeadingId = (text: string): string | undefined => {
  if (
    entry.data.pageId !== "privacy" ||
    privacyChoicesAnchorAssigned ||
    text.trim() !== "Your privacy choices"
  ) {
    return undefined;
  }
  privacyChoicesAnchorAssigned = true;
  return "your-privacy-choices";
};
const groups = renderContentGroups(blocks, (block, index) => ({
  id: block.type === "headline" ? privacyChoicesHeadingId(block.data.text) : undefined,
  generatedHeadingLevel: generatedHeadingLevelAt(blocks, index),
  html: renderBlock(block, {
    sponsors,
    resolveDataFigure,
    resolveDataHubSection,
    resolveAsset: (assetId, placement) =>
      responsiveAssets.get(responsiveImageKey(assetId, placement)) ?? newsletters.images.get(assetId) ??
      (entry.data.assets[assetId]?.mimeType === "application/pdf" ? entry.data.assets[assetId] : null),
    resolveNewsletter: id => newsletters.cards.get(id) ?? null,
    generatedHeadingLevel: generatedHeadingLevelAt(blocks, index),
    richTextHeadingId: privacyChoicesHeadingId,
    // Composed service pages keep the public page frame's rule: external links open in a new tab.
    externalLinksNewTab: usesServiceComposition(entry.data),
    videoPlaceholder: entry.data.contentMode === "draft",
  }),
}));
const publicGroups = groupLinkCardDirectories(groups);
const hasProse = visibleLayoutBlocks(blocks).some(block => block.type === "prose");
---

{readerControls && hasProse && <ReaderTextSize />}

<div
  class:list={[
    "cms-page__blocks",
    {
      wrap: contained,
      "cms-page__blocks--within-frame": !contained,
    },
  ]}
  data-cms-page-blocks={entry.data.pageId}
  data-cms-content-mode={entry.data.contentMode}
>
  {
    publicGroups.map((item) => item.kind === "link-card-directory" ? (
      <LinkCardDirectory groups={item.groups} />
    ) : <CmsBlockGroup group={item.group} cards={recordCards} />)
  }
</div>
