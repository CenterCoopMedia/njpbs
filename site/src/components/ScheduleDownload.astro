---
import type { ScheduleExport } from "../lib/schedule-export";

interface Props { schedule: ScheduleExport; }
const { schedule } = Astro.props as Props;
---

<div class="schedule-download">
  <a
    class="schedule-download__button"
    href={schedule.href}
    download={schedule.filename}
    data-schedule-download-shortcut
  >Download the schedule (PDF)</a>
  <span class="schedule-download__range">{schedule.shortRangeLabel}</span>
</div>

<style>
  .schedule-download {
    display: grid;
    gap: 0.2rem;
    text-align: center;
  }

  .schedule-download__button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--schedule-line-strong);
    border-radius: 3px;
    color: var(--schedule-primary);
    background: color-mix(in srgb, var(--color-white) 4.5%, transparent);
    font: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .schedule-download__button:hover {
    border-color: color-mix(in srgb, var(--color-focus-ring) 62%, transparent);
    background: color-mix(in srgb, var(--color-brand-bright) 16%, transparent);
  }

  .schedule-download__button:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
  }

  .schedule-download__range {
    color: var(--schedule-secondary);
    font-size: 0.82rem;
  }
</style>
