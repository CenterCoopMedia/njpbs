# Independent repository identity required by authorization gates.
CANONICAL_GITHUB_REPOSITORY=
CANONICAL_GITHUB_REPOSITORY_ID=

# Wrangler template inputs: deployment environment only; render before Wrangler.
SHADOW_POST_REVISIONS_KV_NAMESPACE_ID=
RATE_LIMIT_KV_NAMESPACE_ID=
CRAWL_RATE_LIMIT_NAMESPACE_ID=
REPORT_INTAKE_URL=

# Build/deploy resource templates: supply all inputs before source rendering.
