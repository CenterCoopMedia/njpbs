# Export these settings for the commands that need them. Values are placeholders.
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
CLOUDFLARE_PUBLIC_WORKER_TAG=REPLACE_ME
CLOUDFLARE_TOKEN_ENTRY=REPLACE_ME
FIREBASE_WEB_APP_ID=REPLACE_ME
