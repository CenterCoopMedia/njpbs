BOARDWALK_INPUT_HOST=REPLACE_ME
GCP_PROJECT_NUMBER=REPLACE_ME
AWS_ACCOUNT_ID=REPLACE_ME
GOOGLE_RUNTIME_EMAIL=REPLACE_ME@example.org
CMS_DEV_EDITOR_EMAIL=REPLACE_ME@example.org
CMS_DEV_ACCESS_ORIGIN=https://access.example.org
# Absolute executable path. Receives operation and JSON params, returns inbox JSON.
CMS_DEV_INBOX_COMMAND=/path/to/inbox-reader
CMS_STAFF_EMAIL_FROM=REPLACE_ME@example.org
CMS_STAFF_EMAIL_REPLY_TO=REPLACE_ME@example.org
