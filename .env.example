CMS_BUG_REPORT_EMAIL_BCC=audit@example.org
CMS_PUBLISH_GITHUB_INSTALLATION_ID=REPLACE_ME
# Independent expected account for development operations.
CMS_DEV_CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
CMS_PUBLISH_GITHUB_TRUSTED_ACTORS='["REPLACE_ME"]'
SHADOW_POST_READER_ENABLED=false
