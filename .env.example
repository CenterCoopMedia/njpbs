CMS_DEV_FIREBASE_WEB_APP_ID=REPLACE_ME
CMS_BUG_REPORT_TELEGRAM_BOT_ID=REPLACE_ME
CMS_BUG_REPORT_TELEGRAM_BOT_USERNAME=REPLACE_ME
CMS_PUBLISH_GITHUB_APP_ID=REPLACE_ME
