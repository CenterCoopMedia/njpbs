{
  "suppliers": {
    "process-environment": {
      "supplier": "Process environment or explicit configuration input",
      "scope": "Local build, operator or service process",
      "deployStep": "Supply the named input before the build or operator command starts."
    },
    "github-variable": {
      "supplier": "GitHub Actions variable",
      "scope": "Repository or selected deployment environment",
      "deployStep": "Configure the named variable before invoking its workflow; the workflow passes it to the command."
    },
    "github-secret": {
      "supplier": "GitHub Actions secret",
      "scope": "Repository or selected deployment environment",
      "deployStep": "Provision the named secret before invoking the existing workflow; keep values out of logs."
    },
    "functions-parameter": {
      "supplier": "Firebase Functions parameter",
      "scope": "Selected Firebase project",
      "deployStep": "Supply the named parameter in the deployment environment file before Functions deployment."
    },
    "functions-secret": {
      "supplier": "Firebase Functions secret parameter",
      "scope": "Selected Firebase project secret binding",
      "deployStep": "Provision the named secret and bind it during the separately authorized Functions deployment."
    },
    "worker-binding": {
      "supplier": "Worker environment binding",
      "scope": "Selected Worker and deployment environment",
      "deployStep": "Set the named variable, secret or resource binding before the Worker deployment."
    },
    "wordpress-environment": {
      "supplier": "WordPress process environment",
      "scope": "Selected WordPress installation",
      "deployStep": "Set the named setting before PHP bootstrap and scheduled import execution."
    },
    "wrangler-template": {
      "supplier": "Deployment process environment",
      "scope": "Selected Wrangler template",
      "deployStep": "Run node scripts/render-wrangler-config.mjs --config TEMPLATE with the named environment inputs before invoking Wrangler; pass --env to both for a selected profile and remove the generated config afterward."
    },
    "vite-build": {
      "supplier": "Vite build environment",
      "scope": "Selected admin or public-site build",
      "deployStep": "Supply the named build variable before compiling the browser assets."
    },
    "workflow-context": {
      "supplier": "GitHub Actions step environment",
      "scope": "Workflow job outputs and event context",
      "deployStep": "Pass classifier outputs and selected event fields to the existing workflow step; map DISPATCH_SECRET from its configured dispatch secret before authorization."
    },
    "ambient-process": {
      "supplier": "Inherited process environment",
      "scope": "Guarded operator and test processes",
      "deployStep": "Inspect or forward only allowed inherited names before startup; refusal-only credential and emulator inputs must remain unset."
    },
    "source-render": {
      "supplier": "Build and deployment process environment",
      "scope": "Disposable source checkout before builds or operator startup",
      "deployStep": "Run node scripts/render-development-config.mjs --root CHECKOUT with every config/development-inputs.json input before starting tools or builds. Retained renderer sources are verified, then rendered with the same inputs."
    },
    "mail-routing": {
      "supplier": "FANOUT_DESTINATIONS_JSON Worker secret",
      "scope": "Selected email-routing Worker",
      "deployStep": "Set the default, info, engineering, programming and desk arrays before the separately authorized Worker deployment. Supply complete info membership, including shared default recipients, from private configuration. Verify each destination through Email Routing before use."
    }
  },
