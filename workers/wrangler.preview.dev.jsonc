{
  // No route, as in production: the gateway stays unreachable until a staff
  // gate serves dev-preview.example.org through a service binding.
  "name": "template-dev-cms-preview",
  "main": "./src/preview-worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "PREVIEWS", "bucket_name": "template-dev-cms-previews" }],
  "observability": { "enabled": true, "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 } }
}
