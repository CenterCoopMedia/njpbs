{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "njpbs-dev-staff-sites",
  "main": "src/staff-site-dev-worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dev-public.example.org/*", "zone_name": "njpbs.org" }
  ],
  "vars": { "DEV_ACCESS_AUDIENCE": "", "CMS_DEV_ACCESS_ORIGIN": "" },
  "services": [
    { "binding": "DEV_STAFF_ACCESS", "service": "template-dev-cms-api", "entrypoint": "StaffSiteEntrypoint" },
    { "binding": "DEV_PUBLIC", "service": "template-dev-public" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
