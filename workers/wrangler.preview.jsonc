{
  // This Worker stays unreachable until a reviewed Cloudflare Access application
  // and the preview.njpbs.org custom domain are both ready. Deploying the source
  // alone must not expose draft content.
  "name": "njpbs-cms-preview",
  "main": "./src/preview-worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "PREVIEWS",
      "bucket_name": "njpbs-cms-previews"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
