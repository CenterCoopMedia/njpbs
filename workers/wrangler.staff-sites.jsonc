{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "njpbs-staff-sites",
  "main": "src/staff-site-worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The separate njpbs-dev-staff-sites Worker owns dev-public.example.org.
  "routes": [
    { "pattern": "preview.njpbs.org/*", "zone_name": "njpbs.org" }
  ],
  // Change only with the coordinated CMS_DEV_PUBLISH_ENABLED cutover.
  "vars": { "DEV_STAFF_SITE_MODE": "production", "DEV_ACCESS_AUDIENCE": "", "CMS_DEV_ACCESS_ORIGIN": "" },
  "services": [
    { "binding": "STAFF_ACCESS", "service": "njpbs-cms-api", "entrypoint": "StaffSiteEntrypoint" },
    { "binding": "DEV_STAFF_ACCESS", "service": "template-dev-cms-api", "entrypoint": "StaffSiteEntrypoint" },
    { "binding": "PREVIEW", "service": "njpbs-cms-preview" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
