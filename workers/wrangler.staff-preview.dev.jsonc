{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "template-dev-preview-staff-sites",
  "main": "src/dev-preview-staff-worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dev-preview.example.org", "custom_domain": true }],
  "vars": { "DEV_ACCESS_AUDIENCE": "", "CMS_DEV_ACCESS_ORIGIN": "" },
  "services": [
    { "binding": "DEV_STAFF_ACCESS", "service": "template-dev-cms-api", "entrypoint": "StaffSiteEntrypoint" },
    { "binding": "DEV_PREVIEW", "service": "template-dev-cms-preview" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
