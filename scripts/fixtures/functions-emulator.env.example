# Keep every non-secret param represented here so emulator tests stay non-interactive.
# A declared default does not substitute for an entry: firebase-tools treats a param
# as resolved only when a dotenv value exists, and prompts otherwise (#428).
# tests/preflight/params.test.js enforces this and names anything missing.
BOOTSTRAP_SUPER_ADMINS=["editor-fixture-2@example.org","editor-fixture-1@example.org"]
BILLING_BUDGET_TOPIC=billing-budget-alerts
BILLING_DISABLE_THRESHOLD=1.0
BILLING_ALERT_URL=
# Cost ledger pullers remain off in the emulator. Their credentials are secret
# params and are intentionally absent here.
COST_LEDGER_GCP_PULL=false
COST_LEDGER_CLOUDFLARE_PULL=false
COST_LEDGER_AWS_PULL=false
COST_LEDGER_GITHUB_PULL=false
CMS_PUBLISH_TRANSPORT=github
CMS_WRITEBACK_CONFIGURED=true
CMS_PREVIEW_TRANSPORT=serializer
CMS_PREVIEW_SERIALIZER_READY=false
CMS_PREVIEW_RENDERER_SHA=0000000000000000000000000000000000000000
# media.js is not exported yet. These non-secret values keep its emulator
# discovery non-interactive and use a non-routable local bucket configuration.
CMS_MEDIA_R2_ENDPOINT=http://127.0.0.1:9999
CMS_MEDIA_R2_BUCKET=njpbs-cms-media-local
UGC_R2_BUCKET=njpbs-ugc-local
# Empty keeps uploaded originals out of a master bucket; the web copy still publishes.
CMS_MEDIA_MASTER_R2_BUCKET=
CMS_PRIVATE_VIDEO_ENABLED=false
CMS_PRIVATE_VIDEO_R2_ENDPOINT=
CMS_PRIVATE_VIDEO_R2_BUCKET=
CMS_MEDIA_PUBLIC_ORIGIN=https://media.njpbs.org
CMS_MEDIA_CLOUDFLARE_ZONE_ID=
CMS_MEDIA_MAX_UPLOAD_BYTES=26214400
# AWS-backed media sources stay disabled until the workload identity roles and
# private buckets are deployed. These values only prevent emulator prompts.
CMS_MEDIA_AWS_AUDIENCE=njpbs-boardwalk-s3
CMS_MEDIA_AWS_VIDEO_ENABLED=false
CMS_MEDIA_AWS_VIDEO_ACCOUNT_ID=
CMS_MEDIA_AWS_VIDEO_BUCKET=
CMS_MEDIA_AWS_VIDEO_PREFIX=
CMS_MEDIA_AWS_VIDEO_ROLE_ARN=
CMS_MEDIA_AWS_ARCHIVE_ENABLED=false
CMS_MEDIA_AWS_ARCHIVE_ACCOUNT_ID=
CMS_MEDIA_AWS_ARCHIVE_ORIGINALS_BUCKET=
CMS_MEDIA_AWS_ARCHIVE_ORIGINALS_PREFIX=
CMS_MEDIA_AWS_ARCHIVE_WORKING_BUCKET=
CMS_MEDIA_AWS_ARCHIVE_WORKING_PREFIX=
CMS_MEDIA_AWS_ARCHIVE_ROLE_ARN=
# Private voiceover audio uses a separate non-routable local bucket configuration.
CMS_VOICEOVER_R2_ENDPOINT=http://127.0.0.1:9999
CMS_VOICEOVER_R2_BUCKET=njpbs-cms-voiceover-local
CMS_ADMIN_BUILD_REVISION=0000000000000000000000000000000000000000
CMS_DEPLOYMENT_ENVIRONMENT=emulator
# schedule.js is not exported yet, so discovery does not load it today. The keys are
# here so uncommenting scheduleProxy cannot reintroduce the stall; values match the
# declared defaults.
TVSS_CALLSIGN=wnjt
PROXY_EXTRA_ORIGINS=
CMS_STAFF_EMAIL_ACCOUNT_ID=
CMS_STAFF_EMAIL_FROM=editor-fixture-4@example.org
CMS_STAFF_EMAIL_REPLY_TO=editor-1@example.org
CMS_STAFF_EMAIL_ADMIN_ORIGIN=http://127.0.0.1:4173
CMS_BUG_REPORT_TELEGRAM_CHAT_ID=-1001
CMS_BUG_REPORT_TELEGRAM_ADMIN_MAP={"100000001":"local-admin"}
CMS_BUG_REPORT_ADMIN_ORIGIN=http://127.0.0.1:4173
CMS_BUG_REPORT_EMAIL_FROM=editor-fixture-4@example.org
CMS_BUG_REPORT_EMAIL_REPLY_TO=editor-1@example.org
CMS_BUG_REPORT_GITHUB_REPOSITORY=local-owner/local-repository

# Private video viewing copies remain disabled until workflow verification.
CMS_MEDIA_AWS_RENDITION_BUCKET=
CMS_MEDIA_PREVIEW_PROCESSING_ENABLED=false
CMS_MEDIA_PREVIEW_CONTROL_ROLE_ARN=
CMS_MEDIA_PREVIEW_WORKFLOW_ARN=

CMS_MEDIA_CLIP_PROCESSING_ENABLED=false
CMS_MEDIA_EDITOR_EXPORTS_ENABLED=false
CMS_MEDIA_TRANSCRIPT_PROCESSING_ENABLED=false
CMS_MEDIA_TRANSCRIPT_LOCAL_ENABLED=false
CMS_MEDIA_TRANSCRIPT_FALLBACK_ENABLED=false
CMS_MEDIA_TRANSCRIPT_ALIGNMENT_ENABLED=false
CMS_MEDIA_TRANSCRIPT_ALIGNMENT_MODEL_REPOSITORY=Qwen/Qwen3-ForcedAligner-0.6B
CMS_MEDIA_TRANSCRIPT_ALIGNMENT_MODEL_REVISION=c7cbfc2048c462b0d63a45797104fc9db3ad62b7
CMS_MEDIA_TRANSCRIPT_ALIGNMENT_CACHE_SHA256=135b49c5831e94b0dd12d65e8299cb33b85b1e7dbb2b13e696ded81be80a40ad
CMS_MEDIA_TRANSCRIPT_CONTROL_ROLE_ARN=
CMS_MEDIA_TRANSCRIPT_DATA_ROLE_ARN=
CMS_TRANSCRIPTION_CREDENTIAL_KEY_VERSION=
CMS_MEDIA_TRANSCRIPT_BYOK_ENABLED=false
CMS_MEDIA_TRANSCRIPT_BYOK_DATA_ROLE_ARN=

# Analytics providers stay disconnected in the emulator.
CMS_ANALYTICS_GA4_PROPERTY_ID=
CMS_ANALYTICS_CF_ZONE_ID=
CMS_ANALYTICS_MAILCHIMP_AUDIENCE_ID=
CMS_MEDIA_ORIGINAL_COPIES_ENABLED=false
CMS_PUBLISH_GITHUB_REPOSITORY=CenterCoopMedia/njpbs

# Shared audio preparation stays off in local emulators.
CMS_MEDIA_TRANSCRIPT_AUDIO_ENABLED=false
CMS_MEDIA_TRANSCRIPT_AUDIO_FUNCTION_ARN=
CMS_MEDIA_TRANSCRIPT_AUDIO_ARTIFACT_SHA256=

# Optional non-secret parameters remain inert in the demo emulator.
CMS_BUG_REPORT_EMAIL_BCC=[]
CMS_PUBLISH_GITHUB_APP_ID=
CMS_PUBLISH_GITHUB_INSTALLATION_ID=
CMS_STUDIO_TITLE_FILES=
CMS_VIDEO_REPLACEMENT_CLEANUP_DRY_RUN=true
CMS_VIDEO_REPLACEMENT_CLEANUP_ROLE_ARN=
CMS_VIDEO_REPLACEMENT_REPLICA_BUCKET=
